<Project Sdk="Microsoft.NET.Sdk">

  <!-- Developer tool: the map controls on real maps from a T7 bin, without the suite around them. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MapControls\MapControls.csproj" />
    <ProjectReference Include="..\T7Core\T7Core.csproj" />
  </ItemGroup>

</Project>
