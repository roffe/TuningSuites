<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:t8="using:T8SuitePro"
        x:Class="T8App.Views.FlashBlocksWindow"
        Title="Flashblocks browser" Width="820" Height="420" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <!-- frmFlashBlockBrowser: the decoded flash blocks, read only -->
    <DockPanel Margin="12">
        <Button DockPanel.Dock="Bottom" Content="Ok" HorizontalAlignment="Right" MinWidth="80" Margin="0,8,0,0" IsDefault="True" IsCancel="True" Click="OnOk" />
        <DataGrid x:Name="Grid" IsReadOnly="True" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn x:DataType="t8:FlashBlockRow" Header="Blocknumber" Binding="{Binding Blocknumber}" />
                <DataGridTextColumn x:DataType="t8:FlashBlockRow" Header="Blocktype" Binding="{Binding Blocktype}" />
                <DataGridTextColumn x:DataType="t8:FlashBlockRow" Header="Address" Binding="{Binding Address}" />
                <DataGridTextColumn x:DataType="t8:FlashBlockRow" Header="VIN" Binding="{Binding VIN}" />
                <DataGridTextColumn x:DataType="t8:FlashBlockRow" Header="ECU type" Binding="{Binding EcuType}" />
                <DataGridTextColumn x:DataType="t8:FlashBlockRow" Header="Interface" Binding="{Binding Interface}" />
                <DataGridTextColumn x:DataType="t8:FlashBlockRow" Header="SecretCode" Binding="{Binding SecretCode}" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
