<Project Sdk="Microsoft.NET.Sdk">

  <!-- the T8 module of TxSuite: what T8 binaries need their own way (T8Module) and T8's own windows; TxSuite ships its files -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>T8App</RootNamespace>
    <AssemblyName>T8Suite</AssemblyName>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\T8Core\T8Core.csproj" />
    <ProjectReference Include="..\SuiteApp\SuiteApp.csproj" />
  </ItemGroup>

</Project>
