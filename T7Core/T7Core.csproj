<Project Sdk="Microsoft.NET.Sdk">

  <!-- T7 logic lifted from T7Suite/ and CommonSuite/ (Common/), no UI. Original namespaces kept so the files diff against the old code. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>T7</RootNamespace>
    <AssemblyName>T7Core</AssemblyName>
    <Company>MattiasC</Company>
    <Copyright>Copyright © Dilemma, Mattias Claesson</Copyright>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="T7CoreTest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NLog" Version="6.2.1" />
  </ItemGroup>

  <!-- looked up next to the executable: known symbol lists Trionic7File offers for EU0AF01C / EU09F01C bins, tuning pack public key -->
  <ItemGroup>
    <Content Include="EU0AF01C.xml;EU09F01C.xml;T8Pub.pem;DTC_Descriptions.xml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WidebandSupport\WidebandSupport.csproj" />
    <ProjectReference Include="$(TrionicDir)\TrionicCANLib\TrionicCANLib.csproj" />
  </ItemGroup>

</Project>
