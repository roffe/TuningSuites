<Project Sdk="Microsoft.NET.Sdk">

  <!-- T8 logic lifted from T8Suite/, no UI; the CommonSuite code it uses is in SuiteCore. Original namespace (T8SuitePro) kept so
       the files diff against the old code. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>T8SuitePro</RootNamespace>
    <AssemblyName>T8Core</AssemblyName>
    <Company>MattiasC</Company>
    <Copyright>Copyright © Dilemma, Mattias Claesson</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="T8CoreTest" />
  </ItemGroup>

  <ItemGroup>
    <!-- MIT; the encrypted symbol name tables are password-protected (ZipCrypto) zips, which System.IO.Compression can't open -->
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SuiteCore\SuiteCore.csproj" />
    <ProjectReference Include="$(TrionicDir)\TrionicCANLib\TrionicCANLib.csproj" />
  </ItemGroup>

</Project>
