<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:T7App.ViewModels"
             xmlns:v="using:T7App.Views"
             xmlns:mc="using:MapControls"
             xmlns:c="using:T7App.Controls"
             x:Class="T7App.App"
             RequestedThemeVariant="Default">
    <Application.Resources>
        <!-- every host builds its own document view (Dock's recycling moved views between the tabbed and the inner window layout) -->
        <c:NoRecycling x:Key="DocumentRecycling" />
    </Application.Resources>
    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <!-- same neutral dark palette as TrionicCANFlasher, Fluent's own is built on pure black -->
                <ColorPaletteResources x:Key="Dark"
                                       RegionColor="#FF202020"
                                       AltHigh="#FF1B1B1B" AltMediumHigh="#CC1B1B1B" AltMedium="#991B1B1B"
                                       AltMediumLow="#661B1B1B" AltLow="#331B1B1B"
                                       ChromeLow="#FF1E1E1E" ChromeMedium="#FF282828" ChromeMediumLow="#FF323232"
                                       ChromeBlackHigh="#FF141414" ChromeBlackMedium="#CC141414"
                                       ChromeBlackMediumLow="#99141414" ChromeBlackLow="#33141414"
                                       BaseLow="#1CFFFFFF" BaseMediumLow="#40FFFFFF" />
            </FluentTheme.Palettes>
        </FluentTheme>
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
        <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />
        <DockFluentTheme />
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
        <StyleInclude Source="avares://AvaloniaHex/Themes/Fluent/AvaloniaHex.axaml" />
        <!-- inner windows measured at their own size, not the workspace's (a class selector outranks the template's panel) -->
        <Style Selector="ItemsControl.MdiLayoutItems">
            <Setter Property="ItemsPanel">
                <ItemsPanelTemplate>
                    <c:ArrangedMdiLayoutPanel LayoutManager="{Binding $parent[MdiDocumentControl].LayoutManager}" />
                </ItemsPanelTemplate>
            </Setter>
        </Style>
        <!-- the whole MDI title bar moves the window; its title part was Dock's drag-to-dock handle (tabs, splits) -->
        <Style Selector="MdiDocumentWindow /template/ Border#PART_DragHandle">
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style Selector="DockControl">
            <Setter Property="(ControlRecyclingDataTemplate.ControlRecycling)" Value="{StaticResource DocumentRecycling}" />
        </Style>
        <!-- Fluent's tab headers are sized for touch, the suite is a dense desktop tool -->
        <Style Selector="TabStripItem, TabItem">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="10,2" />
        </Style>
    </Application.Styles>
    <!-- the documents' views, here so floating document windows find them too -->
    <Application.DataTemplates>
        <DataTemplate DataType="vm:MapViewerViewModel">
            <mc:MapViewer Map="{Binding Map}" ViewType="{Binding ViewType}" SyncGroup="{Binding SyncGroup}"
                          SaveCommand="{Binding SaveCommand}" CloseCommand="{Binding CloseCommand}" ReadCommand="{Binding ReadCommand}" EditAxisCommand="{Binding EditAxisCommand}"
                          ReadEcuCommand="{Binding EcuReadCommand}" WriteEcuCommand="{Binding EcuWriteCommand}"
                          OnlineMode="{Binding OnlineMode}" CanSaveToFile="{Binding CanSaveToFile}"
                          CanEditXAxis="{Binding CanEditXAxis}" CanEditYAxis="{Binding CanEditYAxis}"
                          IsReadOnly="{Binding IsReadOnly}" IsRedWhite="{Binding IsRedWhite}"
                          DisableColors="{Binding DisableColors}" GraphVisible="{Binding GraphVisible}"
                          OpenLoopMark="{Binding OpenLoopMark}" LiveCell="{Binding LiveCell}" />
        </DataTemplate>
        <DataTemplate DataType="vm:CompareResultsViewModel">
            <v:CompareResultsView />
        </DataTemplate>
        <DataTemplate DataType="vm:RealtimeViewModel">
            <v:RealtimeView />
        </DataTemplate>
        <DataTemplate DataType="vm:LogViewerViewModel">
            <v:LogViewerView />
        </DataTemplate>
        <DataTemplate DataType="vm:AirmassResultViewModel">
            <v:AirmassResultView />
        </DataTemplate>
        <DataTemplate DataType="vm:TuningPackageEditorViewModel">
            <v:TuningPackageEditorView />
        </DataTemplate>
        <DataTemplate DataType="vm:AxisBrowserViewModel">
            <v:AxisBrowserView />
        </DataTemplate>
        <DataTemplate DataType="vm:DisassemblyViewModel">
            <v:DisassemblyView />
        </DataTemplate>
        <DataTemplate DataType="vm:HexViewerViewModel">
            <v:HexViewerView />
        </DataTemplate>
        <DataTemplate DataType="vm:SearchResultsViewModel">
            <v:SearchResultsView />
        </DataTemplate>
    </Application.DataTemplates>
</Application>
