<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:T7App.ViewModels"
        x:Class="T7App.Views.SidInfoWindow"
        x:DataType="vm:SidInfoViewModel"
        Title="SID information selection" Width="1000" Height="640" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
            <Button Content="Export SIDi settings" Click="OnExport" />
            <Button Content="Import SIDi settings" Click="OnImport" />
            <Panel Width="420" />
            <Button Content="Ok" MinWidth="80" IsDefault="True" Click="OnOk" />
            <Button Content="Cancel" MinWidth="80" IsCancel="True" Click="OnCancel" />
        </StackPanel>
        <DataGrid x:Name="Grid" ItemsSource="{Binding View}" GridLinesVisibility="Horizontal" CanUserSortColumns="False">
            <DataGrid.Columns>
                <DataGridTemplateColumn x:DataType="vm:SidRow" Header="Short name" Width="100">
                    <DataTemplate x:DataType="vm:SidRow">
                        <TextBox Text="{Binding Symbol}" IsEnabled="{Binding CanEdit}" MaxLength="4" />
                    </DataTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn x:DataType="vm:SidRow" Header="Symbol" Width="2*">
                    <DataTemplate x:DataType="vm:SidRow">
                        <AutoCompleteBox Text="{Binding T7Symbol}" IsEnabled="{Binding CanEdit}" FilterMode="ContainsOrdinal"
                                         ItemsSource="{Binding $parent[Window].((vm:SidInfoViewModel)DataContext).SymbolNames}" />
                    </DataTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn x:DataType="vm:SidRow" Header="Description" Binding="{Binding Info, Mode=OneWay}" IsReadOnly="True" Width="3*" />
                <DataGridTemplateColumn x:DataType="vm:SidRow" Header="ID" Width="170">
                    <DataTemplate x:DataType="vm:SidRow">
                        <ComboBox ItemsSource="{Binding $parent[Window].((vm:SidInfoViewModel)DataContext).IdNames}" SelectedIndex="{Binding IdIndex}"
                                  IsEnabled="{Binding CanEdit}" HorizontalAlignment="Stretch" />
                    </DataTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn x:DataType="vm:SidRow" Header="Address" Binding="{Binding AddressText, Mode=OneWay}" IsReadOnly="True" Width="90" />
                <DataGridTemplateColumn x:DataType="vm:SidRow" Header="Matched symbol" Width="2*">
                    <DataTemplate x:DataType="vm:SidRow">
                        <Border Background="{Binding Mismatch, Converter={x:Static vm:SidBrushes.Mismatch}}" Padding="6,2">
                            <TextBlock Text="{Binding FoundT7Symbol}" />
                        </Border>
                    </DataTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
