<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:T7App.ViewModels"
        x:Class="T7App.Views.FaultCodesWindow"
        Title="Fault codes" Width="585" Height="303" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
            <Button Content="Clear" MinWidth="80" Click="OnClear" />
            <Button Content="Close" MinWidth="80" IsCancel="True" Click="OnClose" />
        </StackPanel>
        <DataGrid x:Name="Grid" IsReadOnly="True" SelectionMode="Single" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn x:DataType="vm:FaultCode" Header="Code" Binding="{Binding Code, Mode=OneWay}" />
                <DataGridTextColumn x:DataType="vm:FaultCode" Header="Description" Binding="{Binding Description, Mode=OneWay}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
