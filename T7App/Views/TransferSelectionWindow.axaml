<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:T7App.ViewModels"
        x:Class="T7App.Views.TransferSelectionWindow"
        x:DataType="vm:TransferSelectionViewModel"
        Title="Symbol transfer selection..." Width="520" Height="640" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
            <Button Content="Select all" Click="OnAll" />
            <Button Content="Select none" Click="OnNone" />
            <Panel Width="80" />
            <Button Content="Ok" MinWidth="80" IsDefault="True" Click="OnOk" />
            <Button Content="Cancel" MinWidth="80" IsCancel="True" Click="OnCancel" />
        </StackPanel>
        <TextBlock DockPanel.Dock="Top" Text="Select symbols to transfer..." FontWeight="SemiBold" Margin="0,0,0,6" />
        <ListBox ItemsSource="{Binding Items}">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:TransferItem">
                    <CheckBox Content="{Binding Name}" IsChecked="{Binding Selected}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
