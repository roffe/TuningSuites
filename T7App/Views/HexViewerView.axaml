<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:T7App.ViewModels"
             xmlns:hex="clr-namespace:AvaloniaHex;assembly=AvaloniaHex"
             xmlns:r="clr-namespace:AvaloniaHex.Rendering;assembly=AvaloniaHex"
             x:Class="T7App.Views.HexViewerView"
             x:DataType="vm:HexViewerViewModel">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="4">
            <Button Content="Save" Click="OnSave" IsEnabled="{Binding IsModified}" />
            <TextBlock VerticalAlignment="Center" Text="{Binding Status}" />
        </StackPanel>
        <hex:HexEditor x:Name="Editor" FontFamily="Cascadia Mono,Consolas,DejaVu Sans Mono,monospace" FontSize="13">
            <hex:HexEditor.Columns>
                <r:OffsetColumn />
                <r:HexColumn />
                <r:AsciiColumn />
            </hex:HexEditor.Columns>
        </hex:HexEditor>
    </DockPanel>
</UserControl>
