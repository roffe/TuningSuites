<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:T7App.ViewModels"
        x:Class="T7App.Views.LogSelectionWindow"
        x:DataType="vm:LogSelectionViewModel"
        Title="Logfile data selection" Width="520" Height="560" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" Text="Choose items to export" Margin="0,0,0,8" />
        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="12" Margin="0,8,0,0">
            <TextBlock Text="From time" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding From}" PlaceholderText="dd/MM/yyyy HH:mm:ss" />
            <TextBlock Grid.Row="1" Text="Up to time" VerticalAlignment="Center" />
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding To}" PlaceholderText="dd/MM/yyyy HH:mm:ss" />
            <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Content="Select all" Click="OnAll" />
                <Button Content="Select none" Click="OnNone" />
                <Button Content="Ok" MinWidth="80" IsDefault="True" Click="OnOk" />
                <Button Content="Cancel" MinWidth="80" IsCancel="True" Click="OnCancel" />
            </StackPanel>
        </Grid>
        <ListBox ItemsSource="{Binding Symbols}">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:LogSymbolChoice">
                    <CheckBox Content="{Binding Name}" IsChecked="{Binding Selected}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
