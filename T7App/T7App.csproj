<Project Sdk="Microsoft.NET.Sdk">

  <!-- the T7 module of TxSuite: what T7 binaries need their own way (T7Module) and T7's own windows; TxSuite ships its files -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>T7App</RootNamespace>
    <AssemblyName>T7Suite</AssemblyName>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\T7Core\T7Core.csproj" />
    <ProjectReference Include="..\SuiteApp\SuiteApp.csproj" />
  </ItemGroup>

</Project>
