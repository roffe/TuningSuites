<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>T7App</RootNamespace>
    <AssemblyName>T7Suite</AssemblyName>
    <!-- the version comes from the nearest T7suite_vX.Y.Z tag (Directory.Build.props), upstream's release tags -->
    <VersionTagPrefix>T7suite_</VersionTagPrefix>
    <ApplicationIcon>T7Suite.ico</ApplicationIcon>
    <Company>MattiasC</Company>
    <Copyright>Copyright © Dilemma, Mattias Claesson</Copyright>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <!-- ponytail: Windows stays 32-bit like the flasher, most J2534 and the Lawicel CANUSB drivers only ship x86 DLLs. Only the
       launcher (T7Suite.exe) is x86, the dll stays AnyCPU: T7AppTest's 64-bit test host loads it (x86 failed every app test) -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == '' and '$(OS)' == 'Windows_NT'">
    <DefaultAppHostRuntimeIdentifier>win-x86</DefaultAppHostRuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="T7Suite.ico" />
    <AvaloniaResource Include="Assets\Compressormaps\*" />
    <AvaloniaResource Include="Assets\ASM-Mode.xshd" />
    <None Update="NLog.config" CopyToOutputDirectory="PreserveNewest" />
    <!-- Help → User manual / Trionic 7 documentation -->
    <None Include="..\T7_manual.pdf" Link="T7_manual.pdf" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Trionic 7.pdf" Link="Trionic 7.pdf" CopyToOutputDirectory="PreserveNewest" />
    <!-- the stock bins and their symbol files that T7Extras installed (compare to original file, lookup partnumber); only
         published, a build doesn't copy the 130 MB -->
    <None Include="..\T7Binaries\*" Link="Binaries\%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" Visible="false" />
    <!-- Kvaser's CANlib for TrionicCANLib on Windows, as the flasher ships it -->
    <None Include="$(TrionicDir)\Libs\canlib32.dll" Link="canlib32.dll" CopyToOutputDirectory="PreserveNewest"
          Condition="$(RuntimeIdentifier.StartsWith('win')) or ('$(RuntimeIdentifier)' == '' and '$(OS)' == 'Windows_NT')" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
    <!-- the theme, DataGrid, Dock, AvaloniaEdit, AvaloniaHex and the MVVM toolkit come with SuiteApp -->
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(TrionicDir)\TrionicCANLib\TrionicCANLib.csproj" />
    <ProjectReference Include="..\T7Core\T7Core.csproj" />
    <ProjectReference Include="..\SuiteApp\SuiteApp.csproj" />
  </ItemGroup>

</Project>
