<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>T7App</RootNamespace>
    <AssemblyName>T7Suite</AssemblyName>
    <ApplicationIcon>T7Suite.ico</ApplicationIcon>
    <Company>MattiasC</Company>
    <Copyright>Copyright © Dilemma, Mattias Claesson</Copyright>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <!-- ponytail: Windows stays 32-bit like the flasher, most J2534 and the Lawicel CANUSB drivers only ship x86 DLLs -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == '' and '$(OS)' == 'Windows_NT'">
    <PlatformTarget>x86</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="T7Suite.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <!-- MIT; the docking workspace: MDI document windows, tabs and a dockable symbol list -->
    <PackageReference Include="Dock.Avalonia" Version="12.1.0.7" />
    <PackageReference Include="Dock.Model.Avalonia" Version="12.1.0.7" />
    <PackageReference Include="Dock.Avalonia.Themes.Fluent" Version="12.1.0.7" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(TrionicDir)\TrionicCANLib\TrionicCANLib.csproj" />
    <ProjectReference Include="..\T7Core\T7Core.csproj" />
    <ProjectReference Include="..\MapControls\MapControls.csproj" />
  </ItemGroup>

</Project>
