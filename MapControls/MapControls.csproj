<Project Sdk="Microsoft.NET.Sdk">

  <!-- Map table / 3D surface / 2D graph controls for the suites, replacing DevExpress XtraGrid and Nevron charts.
       The 3D surface is a port of txlogger's meshgrid (github.com/roffe/txlogger/pkg/widgets/meshgrid). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>MapControls</RootNamespace>
    <Company>MattiasC</Company>
    <Copyright>Copyright © Dilemma, Mattias Claesson</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MapControlsTest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.3" />
  </ItemGroup>

</Project>
