<Project Sdk="Microsoft.NET.Sdk">

  <!-- the T5 module of TxSuite: what T5 binaries need their own way (T5Module) and T5's own windows; TxSuite ships its files -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>T5App</RootNamespace>
    <AssemblyName>T5Suite</AssemblyName>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\T5Core\T5Core.csproj" />
    <ProjectReference Include="..\SuiteApp\SuiteApp.csproj" />
  </ItemGroup>

</Project>
