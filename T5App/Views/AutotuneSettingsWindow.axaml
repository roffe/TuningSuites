<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:T5App.ViewModels"
        x:Class="T5App.Views.AutotuneSettingsWindow"
        x:DataType="vm:AutotuneSettingsViewModel"
        Title="Autotune settings..." SizeToContent="WidthAndHeight" CanResize="False" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <!-- T5Suite's frmAutotuneSettings: fuel on the left, ignition on the right, a value and its unit per row, its spin ranges and
         steps; its disabled options and the ping sound (its General autotune settings group) aren't ported -->
    <Window.Styles>
        <Style Selector="Grid.values > TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Styles>
    <StackPanel Margin="12" Spacing="6">
        <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="8">
            <HeaderedContentControl Classes="group" Header="Autotune fuel settings">
                <Grid Classes="values" ColumnDefinitions="Auto,130,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="4">
                    <TextBlock Text="Cell stable time" />
                    <NumericUpDown Grid.Column="1" Value="{Binding CellStableTime}" Minimum="100" Maximum="10000" Increment="100" FormatString="0" />
                    <TextBlock Grid.Column="2" Text="ms" />
                    <TextBlock Grid.Row="1" Text="Correction percentage" />
                    <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding CorrectionPercentage}" Minimum="1" Maximum="100" Increment="5" FormatString="0" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="%" />
                    <TextBlock Grid.Row="2" Text="Acceptable target error" />
                    <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding AcceptableTargetError}" Minimum="1" Maximum="10" Increment="1" FormatString="0" />
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="%" />
                    <TextBlock Grid.Row="3" Text="Maximum adjustment per cycle" />
                    <NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding MaximumAdjustment}" Minimum="1" Maximum="20" Increment="1" FormatString="0" />
                    <TextBlock Grid.Row="3" Grid.Column="2" Text="%" />
                    <TextBlock Grid.Row="4" Text="Enrichment filter" />
                    <NumericUpDown Grid.Row="4" Grid.Column="1" Value="{Binding EnrichmentFilter}" Minimum="0" Maximum="255" Increment="1" FormatString="0" />
                    <TextBlock Grid.Row="4" Grid.Column="2" Text="pts" />
                    <CheckBox Grid.Row="5" Grid.ColumnSpan="3" Content="Discard AFR measurements with fuelcut" IsChecked="{Binding DiscardFuelcut}" />
                    <CheckBox Grid.Row="6" Grid.ColumnSpan="3" Content="Discard closed throttle measurements" IsChecked="{Binding DiscardClosedThrottle}" />
                    <CheckBox Grid.Row="7" Grid.ColumnSpan="3" Content="Auto update fuel map" IsChecked="{Binding AutoUpdateFuelMap}" />
                    <CheckBox Grid.Row="8" Grid.ColumnSpan="3" Content="Disable closed loop on starting autotune" IsChecked="{Binding DisableClosedLoop}" />
                    <CheckBox Grid.Row="9" Grid.ColumnSpan="3" Content="Reset fuel trims on starting autotune" IsChecked="{Binding ResetFuelTrims}" />
                    <CheckBox Grid.Row="10" Grid.ColumnSpan="3" Content="Allow idle map autotune" IsChecked="{Binding AllowIdleAutoTune}" />
                </Grid>
            </HeaderedContentControl>
            <HeaderedContentControl Grid.Column="1" Classes="group" Header="Autotune ignition settings" VerticalAlignment="Top">
                <Grid Classes="values" ColumnDefinitions="Auto,130,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="4">
                    <TextBlock Text="Cell stable time" />
                    <NumericUpDown Grid.Column="1" Value="{Binding IgnitionCellStableTime}" Minimum="100" Maximum="10000" Increment="100" FormatString="0" />
                    <TextBlock Grid.Column="2" Text="ms" />
                    <TextBlock Grid.Row="1" Text="Max ignition increase per session" />
                    <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding MaximumAdvancePerSession}" Minimum="0.1" Maximum="20" Increment="0.5" FormatString="0.0" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="degrees" />
                    <TextBlock Grid.Row="2" Text="Global maximum ignition advance" />
                    <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding GlobalMaximumAdvance}" Minimum="0" Maximum="60" Increment="1" FormatString="0.0" />
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="degrees" />
                    <TextBlock Grid.Row="3" Text="Ignition increase per cycle" />
                    <NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding IgnitionAdvancePerCycle}" Minimum="0.1" Maximum="2" Increment="0.1" FormatString="0.0" />
                    <TextBlock Grid.Row="3" Grid.Column="2" Text="degrees" />
                    <TextBlock Grid.Row="4" Text="Ignition retard on first knock" />
                    <NumericUpDown Grid.Row="4" Grid.Column="1" Value="{Binding RetardFirstKnock}" Minimum="0.1" Maximum="2" Increment="0.1" FormatString="0.0" />
                    <TextBlock Grid.Row="4" Grid.Column="2" Text="degrees" />
                    <TextBlock Grid.Row="5" Text="Ignition retard on further knocks" />
                    <NumericUpDown Grid.Row="5" Grid.Column="1" Value="{Binding RetardFurtherKnocks}" Minimum="0.1" Maximum="2" Increment="0.1" FormatString="0.0" />
                    <TextBlock Grid.Row="5" Grid.Column="2" Text="degrees" />
                    <TextBlock Grid.Row="6" Text="Minimal engine speed for tuning" />
                    <NumericUpDown Grid.Row="6" Grid.Column="1" Value="{Binding MinimumEngineSpeed}" Minimum="100" Maximum="10000" Increment="1" FormatString="0" />
                    <TextBlock Grid.Row="6" Grid.Column="2" Text="rpm" />
                    <CheckBox Grid.Row="7" Grid.ColumnSpan="3" IsChecked="{Binding CapIgnitionMap}" MaxWidth="460" HorizontalAlignment="Left">
                        <TextBlock Text="Adjust ignition map to global maximum ignition advance before starting a session" TextWrapping="Wrap" />
                    </CheckBox>
                </Grid>
            </HeaderedContentControl>
        </Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,6,0,0">
            <Button Content="Cancel" MinWidth="80" IsCancel="True" Click="OnCancel" />
            <Button Content="Ok" MinWidth="80" IsDefault="True" Click="OnOk" />
        </StackPanel>
    </StackPanel>
</Window>
