<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:T5App.ViewModels"
        x:Class="T5App.Views.FirmwareOptionsWindow"
        x:DataType="vm:FirmwareOptionsViewModel"
        Title="Trionic firmware settings" Width="1100" Height="860" WindowStartupLocation="CenterOwner">
    <!-- frmEasyFirmwareSettings' groups; the flags come from the view model's table -->
    <Window.DataTemplates>
        <DataTemplate DataType="vm:OptionFlag">
            <CheckBox Content="{Binding Caption}" IsChecked="{Binding IsChecked}" IsEnabled="{Binding IsEnabled}" />
        </DataTemplate>
        <DataTemplate DataType="vm:OptionGroup">
            <HeaderedContentControl Header="{Binding Name}" Margin="0,0,12,8">
                <ItemsControl ItemsSource="{Binding Flags}" />
            </HeaderedContentControl>
        </DataTemplate>
    </Window.DataTemplates>
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
            <Button Content="Ok" MinWidth="80" IsDefault="True" Click="OnOk" />
            <Button Content="Cancel" MinWidth="80" IsCancel="True" Click="OnCancel" />
        </StackPanel>
        <ScrollViewer>
    <StackPanel Spacing="8">
        <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
            <HeaderedContentControl Header="Car specifics">
                <StackPanel Spacing="4">
                    <Grid ColumnDefinitions="190,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="4">
                        <TextBlock Text="Car model" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding CarModel, Mode=OneWay}" IsReadOnly="True" />
                        <TextBlock Grid.Row="1" Text="Engine type" VerticalAlignment="Center" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding EngineType, Mode=OneWay}" IsReadOnly="True" />
                        <TextBlock Grid.Row="2" Text="Injectors" VerticalAlignment="Center" />
                        <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{x:Static vm:FirmwareOptionsViewModel.Injectors}" SelectedItem="{Binding Injector}" HorizontalAlignment="Stretch" />
                        <TextBlock Grid.Row="3" Text="Mapsensor" VerticalAlignment="Center" />
                        <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{x:Static vm:FirmwareOptionsViewModel.MapSensors}" SelectedItem="{Binding MapSensor}" HorizontalAlignment="Stretch" />
                        <TextBlock Grid.Row="4" Text="Turbo" VerticalAlignment="Center" />
                        <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{x:Static vm:FirmwareOptionsViewModel.Turbos}" SelectedItem="{Binding Turbo}" HorizontalAlignment="Stretch" />
                        <TextBlock Grid.Row="5" Text="Tuning stage" VerticalAlignment="Center" />
                        <ComboBox Grid.Row="5" Grid.Column="1" ItemsSource="{x:Static vm:FirmwareOptionsViewModel.Stages}" SelectedItem="{Binding Stage}" HorizontalAlignment="Stretch" />
                        <TextBlock Grid.Row="6" Text="Synchronization timestamp" VerticalAlignment="Center" />
                        <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding SyncTimestamp, Mode=OneWay}" IsReadOnly="True" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding CarGroup.Flags}" />
                </StackPanel>
            </HeaderedContentControl>
            <HeaderedContentControl Grid.Column="1" Header="ECU specifics">
                <StackPanel Spacing="4">
                    <Grid ColumnDefinitions="190,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="4">
                        <TextBlock Text="CPU speed" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding CpuSpeed, Mode=OneWay}" IsReadOnly="True" />
                        <TextBlock Grid.Row="1" Text="Dataname" VerticalAlignment="Center" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Dataname, Mode=OneWay}" IsReadOnly="True" />
                        <TextBlock Grid.Row="2" Text="Partnumber" VerticalAlignment="Center" />
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Partnumber}" MaxLength="{Binding PartnumberLength}" />
                        <TextBlock Grid.Row="3" Text="Software ID" VerticalAlignment="Center" />
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding SoftwareId, Mode=OneWay}" IsReadOnly="True" />
                        <TextBlock Grid.Row="4" Text="VSS code" VerticalAlignment="Center" />
                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding VssCode}" MaxLength="{Binding VssCodeLength}" IsEnabled="{Binding HasVss}" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding EcuGroup.Flags}" />
                </StackPanel>
            </HeaderedContentControl>
        </Grid>
        <ItemsControl ItemsSource="{Binding FlagGroups}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="3" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>
        <Expander Header="Advanced" HorizontalAlignment="Stretch">
            <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasRpmLimit}">
                    <TextBlock Text="Hardcoded RPM limit" VerticalAlignment="Center" />
                    <NumericUpDown Value="{Binding RpmLimit}" Minimum="3000" Maximum="12000" Increment="100" FormatString="0" Width="140" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding AdvancedGroup.Flags}" />
            </StackPanel>
        </Expander>
    </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
