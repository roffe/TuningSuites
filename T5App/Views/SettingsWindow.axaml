<sv:SuiteSettingsWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:T5App.ViewModels"
        xmlns:sv="using:SuiteApp.Views"
        xmlns:c="using:SuiteApp.Controls"
        xmlns:v="using:T5App.Views"
        xmlns:sys="using:System"
        x:Class="T5App.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="Settings" SizeToContent="WidthAndHeight" CanResize="False" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <!-- T5Suite's frmSettings: its two groups, three columns each, its captions in their places; the options not ported are left
         out, the columns close up. The connection and the serial wideband (shared with T7 / T8) sit in T7Suite's bottom rows. -->
    <Window.Styles>
        <Style Selector="Grid.columns > TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Grid.pair > TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Styles>
    <StackPanel Margin="12" Spacing="6">
        <HeaderedContentControl Classes="group" Header="User interface settings">
            <Grid Classes="columns" ColumnDefinitions="300,300,300" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="2">
                <CheckBox Content="Use red and white maps" IsChecked="{Binding ShowRedWhite}">
                    <ToolTip.Tip><c:SuperTip Title="Use red and white maps" Text="When checked, displays maps in red and transparent only. Normally green is used to display low values and red for higher values." /></ToolTip.Tip>
                </CheckBox>
                <CheckBox Grid.Row="1" Content="Don't display colors in mapviewer" IsChecked="{Binding DisableMapviewerColors}">
                    <ToolTip.Tip><c:SuperTip Title="Don't display colors in mapviewer" Text="To improve performance you can check this item and coloring of the mapviewer cells will be disabled." /></ToolTip.Tip>
                </CheckBox>
                <CheckBox Grid.Row="2" Content="Show graphs in mapviewer" IsChecked="{Binding ShowGraphs}">
                    <ToolTip.Tip><c:SuperTip Title="Show graphs in mapviewer" Text="When checked the graphical representation of the selected map will also be displayed. This consumes more system memory and cpu time." /></ToolTip.Tip>
                </CheckBox>
                <CheckBox Grid.Row="3" Content="Show addresses in hex" IsChecked="{Binding ShowAddressesInHex}">
                    <ToolTip.Tip><c:SuperTip Title="Show addresses in hex" Text="When checked, addresses and lengths in the symbol list and the search results, and the lengths in the compare results, are shown in hexadecimal, otherwise in decimal. The symbol list's find box and filter row match them as shown." /></ToolTip.Tip>
                </CheckBox>
                <CheckBox Grid.Row="4" Content="Request a note on changes" IsChecked="{Binding RequestProjectNotes}">
                    <ToolTip.Tip><c:SuperTip Title="Request a note on changes" Text="Determines whether T5Suite should prompt for a note when a change is made to a symbol while working in a project." /></ToolTip.Tip>
                </CheckBox>
                <CheckBox Grid.Row="5" Content="Auto detect mapsensor type" IsChecked="{Binding AutoDetectMapsensorType}">
                    <ToolTip.Tip><c:SuperTip Title="Auto detect mapsensor type" Text="If checked, T5Suite will try to determine the used mapsensor type in the file by examining certain maps." /></ToolTip.Tip>
                </CheckBox>
                <CheckBox Grid.Column="1" Content="Auto load last file on startup" IsChecked="{Binding AutoLoadLastFile}">
                    <ToolTip.Tip><c:SuperTip Title="Auto load last file on startup" Text="Lets you decide whether or not the last used file should be automatically loaded when the program starts up." /></ToolTip.Tip>
                </CheckBox>
                <CheckBox Grid.Row="1" Grid.Column="1" Content="Hide symbol window" IsChecked="{Binding HideSymbolTable}">
                    <ToolTip.Tip><c:SuperTip Title="Hide symbol window" Text="To save display space you can hide the symbol list to a tab at the side of the window. The tab brings the list out again, and it slides away when you open a map." /></ToolTip.Tip>
                </CheckBox>
                <CheckBox Grid.Row="2" Grid.Column="1" Content="Show map preview popup" IsChecked="{Binding ShowMapPreviewPopup}">
                    <ToolTip.Tip><c:SuperTip Title="Show map preview popup" Text="When checked, pointing at a symbol's name in the symbol list shows its map from the file as a read-only table in a popup." /></ToolTip.Tip>
                </CheckBox>
                <CheckBox Grid.Column="2" Content="Synchronize mapviewers" IsChecked="{Binding SynchronizeMapviewers}">
                    <ToolTip.Tip><c:SuperTip Title="Synchronize mapviewers" Text="When checked, mapviewers that show the same map will react to changes made in one of them. E.g. selecting cells or turning the 3D graph." /></ToolTip.Tip>
                </CheckBox>
                <CheckBox Grid.Row="1" Grid.Column="2" Content="Auto update checksum" IsChecked="{Binding AutoChecksum}">
                    <ToolTip.Tip><c:SuperTip Title="Auto update checksum" Text="If checked, the application will make sure that the checksum in the opened file will be updated when needed. If not checked, changes from Firmware information, autotune, Import SRAM snapshot into binary, Upload SRAM to ECU and ECU synchronization leave the checksum as it is and flashing asks first; map saves and the tuning wizards always update it." /></ToolTip.Tip>
                </CheckBox>
                <CheckBox Grid.Row="2" Grid.Column="2" Content="Advanced mode enabled" IsChecked="{Binding EnableAdvancedMode}">
                    <ToolTip.Tip><c:SuperTip Title="Advanced mode enabled" Text="If checked, all advanced topics will be visible. If you are not sure whether you need this, leave it unchecked." /></ToolTip.Tip>
                </CheckBox>
                <TextBlock Grid.Row="3" Grid.Column="1" Text="Default view type for maps">
                    <ToolTip.Tip><c:SuperTip Title="Default view type for maps" Text="Lets you choose the view type a symbol's map opens in: decimal view, or easy view, which shows the values converted with the map's factor and offset. Hexadecimal view opens maps in easy view too. Each mapviewer can still be switched to another view type." /></ToolTip.Tip>
                </TextBlock>
                <ComboBox Grid.Row="3" Grid.Column="2" ItemsSource="{Binding ViewTypes}" SelectedIndex="{Binding DefaultViewType}" HorizontalAlignment="Stretch">
                    <ToolTip.Tip><c:SuperTip Title="Default view type for maps" Text="Lets you choose the view type a symbol's map opens in: decimal view, or easy view, which shows the values converted with the map's factor and offset. Hexadecimal view opens maps in easy view too. Each mapviewer can still be switched to another view type." /></ToolTip.Tip>
                </ComboBox>
                <TextBlock Grid.Row="4" Grid.Column="1" Text="Color blind mode">
                    <ToolTip.Tip><c:SuperTip Title="Color blind mode" Text="Lets you choose a color scale for maps and their graphs that is easier to tell apart with color blindness, instead of the normal green, yellow and red. Open mapviewers change at once; red and white tables and maps opened while connected to the ECU keep their own colors." /></ToolTip.Tip>
                </TextBlock>
                <ComboBox Grid.Row="4" Grid.Column="2" ItemsSource="{Binding ColorBlindModes}" SelectedIndex="{Binding ColorBlindMode}" HorizontalAlignment="Stretch">
                    <ToolTip.Tip><c:SuperTip Title="Color blind mode" Text="Lets you choose a color scale for maps and their graphs that is easier to tell apart with color blindness, instead of the normal green, yellow and red. Open mapviewers change at once; red and white tables and maps opened while connected to the ECU keep their own colors." /></ToolTip.Tip>
                </ComboBox>
                <TextBlock Grid.Row="5" Grid.Column="1" Text="Project folder">
                    <ToolTip.Tip><c:SuperTip Title="Project folder" Text="Lets you choose the folder in which T5Suite creates its projects and in which Open a project looks for them. Each project is a subfolder there with a copy of its binary, its transaction log and its logbook." /></ToolTip.Tip>
                </TextBlock>
                <TextBox Grid.Row="5" Grid.Column="2" Text="{Binding ProjectFolder}" ToolTip.Tip="{Binding ProjectFolder}">
                    <TextBox.InnerRightContent>
                        <Button Content="..." Padding="6,0" Click="OnBrowse" />
                    </TextBox.InnerRightContent>
                </TextBox>
                <TextBlock Grid.Row="6" Grid.Column="1" Text="Symbol list font size">
                    <ToolTip.Tip><c:SuperTip Title="Symbol list font size" Text="Lets you choose the size of the text in the symbol list, in pixels (8 to 24); its rows grow and shrink with it. The list changes at once." /></ToolTip.Tip>
                </TextBlock>
                <NumericUpDown Grid.Row="6" Grid.Column="2" Value="{Binding SymbolListFontSize}" Minimum="8" Maximum="24" Increment="1" FormatString="0" Width="120" HorizontalAlignment="Left">
                    <ToolTip.Tip><c:SuperTip Title="Symbol list font size" Text="Lets you choose the size of the text in the symbol list, in pixels (8 to 24); its rows grow and shrink with it. The list changes at once." /></ToolTip.Tip>
                </NumericUpDown>
                <TextBlock Grid.Row="7" Grid.Column="1" Text="Mapviewer cell spacing">
                    <ToolTip.Tip><c:SuperTip Title="Mapviewer cell spacing" Text="Lets you choose the space between the cells of a map table, in pixels (0 to 20). With a space the cells show as separate tiles without lines between them; at 0 they touch as in the old suites. Open mapviewers change at once." /></ToolTip.Tip>
                </TextBlock>
                <NumericUpDown Grid.Row="7" Grid.Column="2" Value="{Binding MapCellGap}" Minimum="0" Maximum="20" Increment="1" FormatString="0" Width="120" HorizontalAlignment="Left">
                    <ToolTip.Tip><c:SuperTip Title="Mapviewer cell spacing" Text="Lets you choose the space between the cells of a map table, in pixels (0 to 20). With a space the cells show as separate tiles without lines between them; at 0 they touch as in the old suites. Open mapviewers change at once." /></ToolTip.Tip>
                </NumericUpDown>
            </Grid>
        </HeaderedContentControl>
        <HeaderedContentControl Classes="group" Header="Realtime settings">
            <Grid Classes="columns" ColumnDefinitions="300,300,300" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="2"
                  Grid.IsSharedSizeScope="True">
                <CheckBox Content="Interpolate timescale for LogWorks" IsChecked="{Binding InterpolateLogWorksTimescale}">
                    <ToolTip.Tip><c:SuperTip Title="Interpolate timescale for LogWorks" Text="If checked, T5Suite will interpolate the measurements from the canbus to match the 0.083 second interval that LogWorks uses, when exporting a logfile to LogWorks." /></ToolTip.Tip>
                </CheckBox>
                <CheckBox Grid.Row="1" Content="Always generate AFR maps" IsChecked="{Binding AlwaysCreateAfrMaps}">
                    <ToolTip.Tip><c:SuperTip Title="Always generate AFR maps" Text="When checked, T5Suite sets up the AFR maps (target, feedback and counter maps in an AFRMaps folder next to the file) as soon as a file is opened, instead of when they are first needed. Missing maps are created, existing ones are loaded." /></ToolTip.Tip>
                </CheckBox>
                <CheckBox Grid.Row="2" Content="Knock counter snapshot after disconnect" IsChecked="{Binding KnockCounterSnapshot}">
                    <ToolTip.Tip><c:SuperTip Title="Knock counter snapshot after disconnect" Text="When checked, T5Suite saves the ECU's knock counter map (Knock_count_map) as a .KNK file in the Snapshots folder (the project's, else next to the file) when you stop the realtime panel or disconnect from the ECU. T5.5 only; Knock map snapshots lists them." /></ToolTip.Tip>
                </CheckBox>
                <CheckBox Grid.Row="1" Grid.Column="1" Content="Use wideband lambda through symbol" IsChecked="{Binding UseWidebandLambda}">
                    <ToolTip.Tip><c:SuperTip Title="Use wideband lambda through symbol" Text="Lets you select which symbol to read from the ECU's memory that should be used as wideband lambda values." /></ToolTip.Tip>
                </CheckBox>
                <Grid Grid.Row="2" Grid.Column="1" Classes="pair" ColumnDefinitions="*,140" ColumnSpacing="8">
                    <ToolTip.Tip><c:SuperTip Title="Low voltage (Volt)" Text="Lets you set the low end of the wideband's voltage to AFR conversion: this voltage equals the AFR next to it, and voltages in between convert on a straight line." /></ToolTip.Tip>
                    <TextBlock Text="Low voltage (Volt)" />
                    <NumericUpDown Grid.Column="1" Value="{Binding WidebandLowVoltage}" Minimum="0" Maximum="5" Increment="0.1" FormatString="0.00" />
                </Grid>
                <Grid Grid.Row="3" Grid.Column="1" Classes="pair" ColumnDefinitions="*,140" ColumnSpacing="8">
                    <ToolTip.Tip><c:SuperTip Title="High voltage (Volt)" Text="Lets you set the high end of the wideband's voltage to AFR conversion: this voltage equals the AFR next to it, and voltages in between convert on a straight line." /></ToolTip.Tip>
                    <TextBlock Text="High voltage (Volt)" />
                    <NumericUpDown Grid.Column="1" Value="{Binding WidebandHighVoltage}" Minimum="0" Maximum="5" Increment="0.1" FormatString="0.00" />
                </Grid>
                <CheckBox Grid.Row="4" Grid.Column="1" Content="Auto update SRAM viewers every" IsChecked="{Binding AutoUpdateSRAMViewers}">
                    <ToolTip.Tip><c:SuperTip Title="Auto update SRAM viewers every" Text="When checked, T5Suite reads the maps of the online map viewers (opened or read from the ECU while connected) from the ECU every given number of seconds (5 to 60) while connected. Viewers with unsaved changes are left alone." /></ToolTip.Tip>
                </CheckBox>
                <!-- the port's extras where T7Suite has them -->
                <CheckBox Grid.Column="2" Content="Measure AFR in lambda" IsChecked="{Binding MeasureAFRInLambda}">
                    <ToolTip.Tip><c:SuperTip Title="Measure AFR in lambda" Text="If you prefer AFR measurements in lambda values instead of AFR values, enable this." /></ToolTip.Tip>
                </CheckBox>
                <ComboBox Grid.Row="1" Grid.Column="2" ItemsSource="{Binding WidebandSymbols}" SelectedItem="{Binding WideBandSymbol}" HorizontalAlignment="Stretch">
                    <ToolTip.Tip><c:SuperTip Title="Use wideband lambda through symbol" Text="Lets you select which symbol to read from the ECU's memory that should be used as wideband lambda values." /></ToolTip.Tip>
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="sys:String">
                            <TextBlock Text="{Binding Converter={x:Static v:SettingsWindow.PinCaption}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Grid Grid.Row="2" Grid.Column="2" Classes="pair" ColumnDefinitions="*,140" ColumnSpacing="8">
                    <ToolTip.Tip><c:SuperTip Title="Low voltage (Volt)" Text="Lets you set the low end of the wideband's voltage to AFR conversion: this voltage equals the AFR next to it, and voltages in between convert on a straight line." /></ToolTip.Tip>
                    <TextBlock Text="equals AFR" />
                    <NumericUpDown Grid.Column="1" Value="{Binding WidebandLowAFR}" Minimum="5" Maximum="30" Increment="0.1" FormatString="0.00" />
                </Grid>
                <Grid Grid.Row="3" Grid.Column="2" Classes="pair" ColumnDefinitions="*,140" ColumnSpacing="8">
                    <ToolTip.Tip><c:SuperTip Title="High voltage (Volt)" Text="Lets you set the high end of the wideband's voltage to AFR conversion: this voltage equals the AFR next to it, and voltages in between convert on a straight line." /></ToolTip.Tip>
                    <TextBlock Text="equals AFR" />
                    <NumericUpDown Grid.Column="1" Value="{Binding WidebandHighAFR}" Minimum="5" Maximum="30" Increment="0.1" FormatString="0.00" />
                </Grid>
                <StackPanel Grid.Row="4" Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <ToolTip.Tip><c:SuperTip Title="Auto update SRAM viewers every" Text="When checked, T5Suite reads the maps of the online map viewers (opened or read from the ECU while connected) from the ECU every given number of seconds (5 to 60) while connected. Viewers with unsaved changes are left alone." /></ToolTip.Tip>
                    <NumericUpDown Value="{Binding AutoUpdateInterval}" Minimum="5" Maximum="60" Increment="1" FormatString="0" Width="120" />
                    <TextBlock Text="seconds" VerticalAlignment="Center" />
                </StackPanel>
                <CheckBox Grid.Row="5" Grid.Column="2" Content="Use wideband O2 on com port" IsChecked="{Binding UseDigitalWidebandLambda}">
                    <ToolTip.Tip><c:SuperTip Title="Use wideband O2 on com port" Text="When checked, T5Suite reads the wideband controller chosen under Wideband device on the Wideband com port while the realtime panel runs. Its reading is used as the realtime AFR and is shown and logged as Wideband." /></ToolTip.Tip>
                </CheckBox>
                <Grid Grid.Row="6" Classes="pair" ColumnSpacing="8" Margin="0,6,0,0">
                    <ToolTip.Tip><c:SuperTip Title="CANBus adapter type" Text="Lets you choose which CAN bus device to use for ECU interaction." /></ToolTip.Tip>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Label0" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="CANBus adapter type" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding AdapterTypes}" SelectedItem="{Binding AdapterType}" HorizontalAlignment="Stretch" />
                </Grid>
                <Grid Grid.Row="6" Grid.Column="1" Classes="pair" ColumnSpacing="8" Margin="0,6,0,0">
                    <ToolTip.Tip><c:SuperTip Title="Adapter" Text="Lets you choose which adapter of the selected type to use; for an OBDLink SX / EX, ELM327, Just4Trionic or SLCAN adapter this is its serial port. The CombiAdapter is found by itself, so the list stays empty for it." /></ToolTip.Tip>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Label1" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Adapter" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Adapters}" SelectedItem="{Binding Adapter}" HorizontalAlignment="Stretch" IsEnabled="{Binding HasAdapters}"
                              PlaceholderText="Select an adapter" />
                </Grid>
                <Grid Grid.Row="6" Grid.Column="2" Classes="pair" ColumnSpacing="8" Margin="0,6,0,0" IsVisible="{Binding AdapterNeedsBaudrate}">
                    <ToolTip.Tip><c:SuperTip Title="Serial speed" Text="Lets you choose the speed of the serial connection to an ELM327 (it is switched to this speed after connecting) or a Just4Trionic. The OBDLink SX and EX switch themselves to 2000000 baud, SLCAN adapters always use 3000000 baud." /></ToolTip.Tip>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Label2" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Serial speed" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Baudrates}" SelectedItem="{Binding Baudrate}" HorizontalAlignment="Stretch" />
                </Grid>
                <Grid Grid.Row="7" Classes="pair" ColumnSpacing="8">
                    <ToolTip.Tip><c:SuperTip Title="Wideband device" Text="Lets you choose the type of wideband controller on the Wideband com port, so T5Suite reads it with that device's own protocol and speed. Only used with Use wideband O2 on com port." /></ToolTip.Tip>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Label0" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Wideband device" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding WidebandDevices}" SelectedItem="{Binding WidebandDevice}" HorizontalAlignment="Stretch"
                              IsEnabled="{Binding UseDigitalWidebandLambda}" />
                </Grid>
                <Grid Grid.Row="7" Grid.Column="1" Classes="pair" ColumnSpacing="8">
                    <ToolTip.Tip><c:SuperTip Title="Wideband com port" Text="Lets you choose the serial port the wideband controller is connected to. Only used with Use wideband O2 on com port." /></ToolTip.Tip>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Label1" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Wideband com port" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding SerialPorts}" SelectedItem="{Binding WbPort}" HorizontalAlignment="Stretch"
                              IsEnabled="{Binding UseDigitalWidebandLambda}" />
                </Grid>
            </Grid>
        </HeaderedContentControl>
        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,6,0,0">
            <Button Content="Autotune settings" Click="OnAutotuneSettings" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <Button Content="Cancel" MinWidth="80" IsCancel="True" Click="OnCancel" />
                <Button Content="Ok" MinWidth="80" IsDefault="True" Click="OnOk" />
            </StackPanel>
        </Grid>
    </StackPanel>
</sv:SuiteSettingsWindow>
