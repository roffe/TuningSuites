<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="using:SuiteApp"
             x:Class="T5App.App"
             RequestedThemeVariant="Default">
    <Application.Styles>
        <StyleInclude Source="avares://SuiteApp/SuiteTheme.axaml" />
    </Application.Styles>
    <!-- the documents' views by name (FooViewModel → FooView), here so floating document windows find them too -->
    <Application.DataTemplates>
        <s:ViewLocator />
    </Application.DataTemplates>
</Application>
