<?xml version="1.0" encoding="utf-8" ?>
<!-- T5Suite's NLog.config (uiLog in <AppData>/MattiasC/T5) plus TrionicCANLib's logs, which T5Suite's own T5CANLib didn't write.
     No CAN frame trace: T5Suite logged none -->
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

  <variable name="layout" value="${longdate} ${message} ${exception:format=tostring}"/>
  <targets>
    <target name="devicelogfile" xsi:type="File" fileName="${specialfolder:folder=ApplicationData}/MattiasC/T5/deviceLog${shortdate}.txt" keepFileOpen="true" layout="${layout}" />
    <target name="flasherlogfile" xsi:type="File" fileName="${specialfolder:folder=ApplicationData}/MattiasC/T5/flasherLog${shortdate}.txt" keepFileOpen="true" layout="${layout}" />
    <target name="apilogfile" xsi:type="File" fileName="${specialfolder:folder=ApplicationData}/MattiasC/T5/apiLog${shortdate}.txt" keepFileOpen="true" layout="${layout}" />
    <target name="uilogfile" xsi:type="File" fileName="${specialfolder:folder=ApplicationData}/MattiasC/T5/uiLog${shortdate}.txt" keepFileOpen="true" layout="${layout}" />
    <target name="debugger" xsi:type="Debugger" layout="${logger}::${message}"/>
  </targets>

  <rules>
    <logger name="TrionicCANLib.CAN.*" level="Debug" writeTo="devicelogfile" />
    <!-- the adapter drivers keep their original namespaces (as in the flasher's config) -->
    <logger name="Lawicel.*" minLevel="Debug" writeTo="devicelogfile" />
    <logger name="Combi.*" minLevel="Debug" writeTo="devicelogfile" />
    <logger name="TrionicCANLib.Flasher.*" level="Debug" writeTo="flasherlogfile" />
    <logger name="TrionicCANLib.API.*" level="Debug" writeTo="apilogfile" />
    <!-- T5Core keeps Trionic5Tools' namespace -->
    <logger name="Trionic5Tools.*" minLevel="Trace" writeTo="uilogfile" />
    <logger name="T5App.*" minLevel="Trace" writeTo="uilogfile" />

    <logger name="TrionicCANLib.API.*" level="Debug" writeTo="debugger" />
    <logger name="Trionic5Tools.*" minLevel="Trace" writeTo="debugger" />
  </rules>
</nlog>
