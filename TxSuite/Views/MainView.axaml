<sv:SuiteMainView xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TxSuite.ViewModels"
        xmlns:sv="using:SuiteApp.Views"
        xmlns:c="using:SuiteApp.Controls"
        x:Class="TxSuite.Views.MainView"
        x:DataType="vm:MainViewModel">
    <UserControl.KeyBindings>
        <KeyBinding Gesture="Shift+F1" Command="{Binding ToggleRealtimePanelCommand}" />
        <KeyBinding Gesture="F6" Command="{Binding WriteLogMarkerCommand}" />
        <KeyBinding Gesture="Shift+F5" Command="{Binding T5Realtime.ToggleAutotuneCommand, FallbackValue={x:Null}}" />
    </UserControl.KeyBindings>
    <UserControl.Resources>
        <!-- the symbol list's row menu, in the order the three suites shared; an ECU's own items while its file is open -->
        <ContextMenu x:Key="SymbolListMenu" x:DataType="vm:MainViewModel">
            <MenuItem Header="Read symbol from ECU" Click="OnReadSymbolFromEcu" IsVisible="{Binding IsT7}" />
            <MenuItem Header="Add to realtime list" Click="OnAddToRealtime" />
            <MenuItem Header="Add to realtime user maps" Click="OnAddToRealtimeUserMaps" IsVisible="{Binding IsT5}" />
            <MenuItem Header="Add to MyMaps" Click="OnAddToMyMaps" />
            <MenuItem Header="Read from SRAM file" Click="OnReadFromSramFile" IsEnabled="{Binding HasSramFile}" />
            <MenuItem Header="Browse axis information" Click="OnBrowseAxes" />
            <MenuItem Header="Export as tuning package" Click="OnExportPackage" IsVisible="{Binding IsT7OrT8}" />
            <MenuItem Header="Export fixed tuning package" Click="OnExportFixedPackage" IsVisible="{Binding IsT7OrT8}" />
            <MenuItem Header="Edit a tuning package" Command="{Binding EditTuningPackageCommand}" IsVisible="{Binding IsT7OrT8}" />
            <MenuItem Header="Export symbollist as CSV" Click="OnExportSymbolCsv" />
        </ContextMenu>
    </UserControl.Resources>
    <DockPanel>
        <!-- the old suites' menus in one, in the layout they shared: what every ECU has always, an ECU's own items (T5Suite's,
             T7Suite's, T8Suite's, in their places) only while a file of that ECU is open. Shown as the old suites' ribbon instead
             with Settings → Show ribbon bar instead of menus: its groups are the menus' sections, captioned by c:Ribbon.Group (the
             old ribbons' captions) -->
        <Menu x:Name="MainMenu" DockPanel.Dock="Top" IsVisible="{Binding !ShowRibbon}">
            <MenuItem x:Name="FileMenu" Header="_File" c:Ribbon.Group="File actions">
                <MenuItem Header="_Open file..." Click="OnOpenFile" />
                <!-- the files are made by SuiteMainView (BuildRecent) -->
                <MenuItem x:Name="RecentMenu" Header="_Recent" />
                <MenuItem Header="Save all" Command="{Binding SaveAllCommand}" IsEnabled="{Binding HasFile}" />
                <MenuItem Header="Save as..." Click="OnSaveAs" IsEnabled="{Binding HasFile}" />
                <MenuItem Header="Export to S19" Click="OnExportS19" IsVisible="{Binding IsT7OrT8}" />
                <MenuItem Header="Create backup file" Command="{Binding CreateBackupFileCommand}" IsEnabled="{Binding HasFile}" />
                <MenuItem Header="Import XML descriptor" Click="OnImportXml" IsVisible="{Binding IsT7OrT8}" />
                <MenuItem Header="Import AS2 descriptor" Click="OnImportAs2" IsVisible="{Binding IsT7OrT8}" />
                <MenuItem Header="Import CSV descriptor" Click="OnImportCsv" IsVisible="{Binding IsT7OrT8}" />
                <MenuItem Header="Import tuning package" Click="OnImportTuningPackage" IsVisible="{Binding IsT7OrT8}" />
                <MenuItem Header="Edit a tuning package" Command="{Binding EditTuningPackageCommand}" IsVisible="{Binding IsT7OrT8}" />
                <MenuItem Header="Create binary from TIS file" Click="OnCreateFromTis" IsVisible="{Binding IsT8}" />
                <MenuItem Header="Compare to original file" Command="{Binding CompareToOriginalCommand}" IsVisible="{Binding IsT5OrT7}"
                          IsEnabled="{Binding OriginalFile, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <MenuItem Header="Setup log filters" Click="OnLogFilters" />
                <MenuItem Header="Generate Idc file" Click="OnGenerateIdc" IsEnabled="{Binding HasFile}" />
                <Separator c:Ribbon.Group="Options" />
                <MenuItem Header="Settings" Click="OnSettings" />
                <MenuItem Header="Lookup partnumber" Click="OnLookupPartnumber" />
                <MenuItem Header="User library" Click="OnUserLibrary" IsVisible="{Binding IsT5}" />
                <Separator />
                <MenuItem Header="_Project" c:Ribbon.Group="Projects">
                    <MenuItem Header="Create a project" Click="OnCreateProject" />
                    <MenuItem Header="Open a project" Click="OnOpenProject" />
                    <MenuItem Header="Close project" Command="{Binding CloseProjectMenuCommand}" IsEnabled="{Binding IsProjectOpen}" />
                    <Separator />
                    <MenuItem Header="Show transaction log" Click="OnShowTransactionLog" IsEnabled="{Binding HasTransactions}" />
                    <MenuItem Header="Roll back/undo" Command="{Binding RollBackCommand}" IsEnabled="{Binding CanRollBack}" />
                    <MenuItem Header="Roll forward/redo" Command="{Binding RollForwardCommand}" IsEnabled="{Binding CanRollForward}" />
                    <MenuItem Header="Rebuild file" Click="OnRebuild" IsEnabled="{Binding IsProjectOpen}" />
                    <Separator />
                    <MenuItem Header="Edit project" Click="OnEditProject" IsEnabled="{Binding IsProjectOpen}" />
                    <MenuItem Header="Add note to project log" Command="{Binding AddNoteCommand}" IsEnabled="{Binding IsProjectOpen}" />
                    <MenuItem Header="Show project logbook" Click="OnShowLogbook" IsEnabled="{Binding IsProjectOpen}" />
                    <MenuItem Header="Produce latest binary" Click="OnProduceLatest" IsEnabled="{Binding IsProjectOpen}" />
                </MenuItem>
                <Separator />
                <MenuItem Header="E_xit" Command="{Binding ExitCommand}" c:Ribbon.Hidden="True" />
            </MenuItem>
            <MenuItem x:Name="ActionsMenu" Header="_Actions" c:Ribbon.Group="Checksum">
                <MenuItem Header="_Verify checksum" Command="{Binding VerifyChecksumCommand}" IsEnabled="{Binding HasFile}" />
                <Separator c:Ribbon.Group="Information" />
                <MenuItem Header="_Firmware information" Click="OnFirmwareInformation" IsEnabled="{Binding HasFile}" />
                <MenuItem Header="VIN decoder" Click="OnVinDecoder" />
                <MenuItem Header="Browse axis information" Command="{Binding BrowseAxesCommand}" IsEnabled="{Binding HasFile}" />
                <MenuItem Header="Show interrupt vectors" Click="OnVectors" IsEnabled="{Binding HasFile}" />
                <MenuItem Header="Show disassembly" Click="OnDisassembly" IsEnabled="{Binding HasFile}" />
                <MenuItem Header="Show full disassembly" Click="OnFullDisassembly" IsVisible="{Binding IsT7OrT8}" />
                <Separator c:Ribbon.Group="Actions" />
                <MenuItem Header="Compare symbols with other binary" Click="OnCompareToFile" IsEnabled="{Binding HasFile}" />
                <MenuItem Header="Compare binary outside symbolrange" Click="OnBinaryCompareOutsideSymbols" IsVisible="{Binding IsT8}" />
                <MenuItem Header="Compare binary with other binary" Click="OnBinaryCompare" IsEnabled="{Binding HasFile}" />
                <MenuItem Header="Transfer maps to another binary" Click="OnTransferMaps" IsEnabled="{Binding HasFile}" />
                <MenuItem Header="Copy address table to another binary" Click="OnCopyAddressTable" IsVisible="{Binding IsT7OrT8}" />
                <MenuItem Header="Search map content" Click="OnSearchMaps" IsEnabled="{Binding HasFile}" />
                <MenuItem Header="Export map to CSV" Click="OnExportMapCsv" IsEnabled="{Binding HasFile}" />
                <MenuItem Header="Import map from CSV" Click="OnImportMapCsv" IsVisible="{Binding IsT5}" />
                <MenuItem Header="View file in hex" Command="{Binding ViewHexCommand}" IsEnabled="{Binding HasFile}" />
                <Separator c:Ribbon.Group="SRAM snapshots" />
                <MenuItem Header="Compare binary to SRAM snapshot" Click="OnCompareToSram" IsVisible="{Binding IsT5OrT7}" />
                <MenuItem Header="Compare SRAM snapshots" Click="OnCompareSram" IsVisible="{Binding IsT5OrT7}" />
                <MenuItem Header="Binary compare SRAM snapshots" Click="OnBinaryCompareSram" IsVisible="{Binding IsT5}" />
                <MenuItem Header="Import SRAM snapshot" Click="OnImportSram" IsEnabled="{Binding HasFile}" />
                <MenuItem Header="Import SRAM snapshot into binary" Click="OnMergeAdaption" IsVisible="{Binding IsT5}" />
                <Separator IsVisible="{Binding HasFile}" c:Ribbon.Group="Tools" />
                <MenuItem Header="Airmass result viewer" Command="{Binding T7.ShowAirmassResultCommand}" IsVisible="{Binding IsT7}" />
                <MenuItem Header="Airmass result viewer" Command="{Binding T8.ShowAirmassResultCommand}" IsVisible="{Binding IsT8}" />
                <MenuItem Header="SID information" Click="OnSidInfo" IsVisible="{Binding IsT7}" />
                <MenuItem Header="Import AFR feedback data" Command="{Binding T7.ImportAfrFeedbackCommand}" IsVisible="{Binding IsT7}" />
                <MenuItem Header="ESP calibration" Click="OnEsp" IsVisible="{Binding IsT7}" />
                <MenuItem Header="TCM limit" Click="OnTcm" IsVisible="{Binding IsT7}" />
                <MenuItem Header="TEM editor" Click="OnPidEditor" Tag="tem" IsVisible="{Binding IsT8}" IsEnabled="{Binding T8.HasTemTable}" />
                <MenuItem Header="PID editor" Click="OnPidEditor" Tag="pid" IsVisible="{Binding IsT8}" />
                <MenuItem Header="Examine binary" Click="OnExamine" IsVisible="{Binding IsT5}" />
                <MenuItem Header="Check for anomalies" Click="OnAnomalies" IsVisible="{Binding IsT5}" />
                <MenuItem Header="Open a saved report" Click="OnOpenReport" IsVisible="{Binding IsT5}" />
                <MenuItem Header="Show dyno graph" Click="OnDyno" IsVisible="{Binding IsT5}" />
                <MenuItem Header="Show compressor map" Click="OnCompressorMap" IsVisible="{Binding IsT5}" />
                <MenuItem Header="Injection timing viewer" Click="OnInjectionTiming" IsVisible="{Binding IsT5}" />
                <MenuItem Header="Merge binary files" Click="OnMergeFiles" IsVisible="{Binding IsT5}" />
                <MenuItem Header="Split binary file" Click="OnSplitFile" IsVisible="{Binding IsT5}" />
            </MenuItem>
            <!-- T5's tuning wizards and T8's Tuning Wizard, then txlogger's menu for the open file's ECU with the maps the bin has
                 (built in code) -->
            <MenuItem x:Name="QuickMapsMenu" Header="_Tuning" IsEnabled="{Binding HasFile}" c:Ribbon.Group="Tuning wizards">
                <MenuItem Header="Tuning wizards" IsVisible="{Binding IsT5}" c:Ribbon.Group="Tuning wizards">
                    <MenuItem Header="Tune me up ®" Click="OnTuneMeUp" />
                    <Separator IsVisible="{Binding IsT5Advanced}" />
                    <MenuItem Header="Convert to different MAP sensor" IsVisible="{Binding IsT5Advanced}">
                        <MenuItem Header="Convert to 2.5 bar MAP sensor" Click="OnMapSensor" Tag="MapSensor25" />
                        <MenuItem Header="Convert to 3.0 bar MAP sensor" Click="OnMapSensor" Tag="MapSensor30" />
                        <MenuItem Header="Convert to 3.5 bar MAP sensor" Click="OnMapSensor" Tag="MapSensor35" />
                        <MenuItem Header="Convert to 4.0 bar MAP sensor" Click="OnMapSensor" Tag="MapSensor40" />
                        <MenuItem Header="Convert to 5.0 bar MAP sensor" Click="OnMapSensor" Tag="MapSensor50" />
                    </MenuItem>
                    <MenuItem Header="Convert to larger injectors" Click="OnInjectors" IsVisible="{Binding IsT5Advanced}" />
                    <MenuItem Header="Convert to E85 (ethanol) fuel" Click="OnE85" IsVisible="{Binding IsT5Advanced}" />
                    <MenuItem Header="Change boost adaption ranges" Click="OnBoostAdaption" IsVisible="{Binding IsT5Advanced}" />
                    <MenuItem Header="Change boost bias range" Click="OnBoostBias" IsVisible="{Binding IsT5Advanced}" />
                    <MenuItem Header="Change RPM limit" Click="OnRpmLimit" IsVisible="{Binding IsT5Advanced}" />
                </MenuItem>
                <MenuItem Header="Tuning Wizard" Click="OnTuningWizard" IsVisible="{Binding IsT8}" />
            </MenuItem>
            <MenuItem x:Name="MyMapsMenu" Header="M_y Maps" c:Ribbon.Group="myMaps settings" />
            <MenuItem x:Name="RealtimeMenu" Header="_Realtime" c:Ribbon.Group="CAN bus connection">
                <MenuItem Header="{Binding ConnectCaption}" Command="{Binding ConnectDisconnectCommand}" />
                <MenuItem Header="Toggle realtime panel" InputGesture="Shift+F1" Command="{Binding ToggleRealtimePanelCommand}" IsEnabled="{Binding HasFile}" />
                <MenuItem Header="Configure realtime panel" Command="{Binding ConfigureRealtimePanelCommand}" IsVisible="{Binding IsT5}" />
                <MenuItem Header="Export logfile to LogWorks" Click="OnExportLogDif" />
                <MenuItem Header="Load logfile" Click="OnOpenLog" />
                <MenuItem Header="View matrix from logfile" Click="OnLogMatrix" IsEnabled="{Binding HasFile}" />
                <MenuItem Header="Set symbol colors" Click="OnSymbolColors" IsEnabled="{Binding HasFile}" />
                <MenuItem Header="Get ECU information" Click="OnEcuInformation" IsVisible="{Binding IsT8}" />
                <MenuItem Header="Get fault codes" Click="OnFaultCodes" IsEnabled="{Binding HasFile}" />
                <MenuItem Header="Clear DTC and knock counters" Command="{Binding T7.ClearDtcAndKnockCountersCommand}" IsVisible="{Binding IsT7}" />
                <MenuItem Header="Clear DTC and knock counters" Command="{Binding T8.ClearDtcAndKnockCountersCommand}" IsVisible="{Binding IsT8}" />
                <MenuItem Header="Clear knock counters" Command="{Binding T5.ClearKnockCountersCommand}" IsVisible="{Binding IsT5}" />
                <MenuItem Header="Write log marker" InputGesture="F6" Command="{Binding WriteLogMarkerCommand}" />
                <MenuItem Header="Export logfile to CSV" Click="OnExportLogCsv" />
                <Separator IsVisible="{Binding HasFile}" c:Ribbon.Group="Tuning in realtime" />
                <MenuItem Header="View knock count map" Command="{Binding ShowEcuMapCommand}" CommandParameter="KnkDetAdap.KnkCntMap" IsVisible="{Binding IsT7}" />
                <MenuItem Header="View false knock map" Command="{Binding ShowEcuMapCommand}" CommandParameter="F_KnkDetAdap.FKnkCntMap" IsVisible="{Binding IsT7}" />
                <MenuItem Header="View real knock map" Command="{Binding ShowEcuMapCommand}" CommandParameter="F_KnkDetAdap.RKnkCntMap" IsVisible="{Binding IsT7}" />
                <MenuItem Header="View misfire map" Command="{Binding ShowEcuMapCommand}" CommandParameter="MissfAdap.MissfCntMap" IsVisible="{Binding IsT7}" />
                <MenuItem Header="View knock count map" Command="{Binding ShowEcuMapCommand}" CommandParameter="KnkDetAdap.KnkCntMAP" IsVisible="{Binding IsT8}" />
                <MenuItem Header="View misfire tab" Command="{Binding ShowEcuMapCommand}" CommandParameter="MisfAdap.N_MisfCountCyl" IsVisible="{Binding IsT8}" />
                <MenuItem Header="Knock map snapshots" Click="OnKnockSnapshots" IsVisible="{Binding IsT5}" />
                <MenuItem Header="AFR maps" IsVisible="{Binding IsT7}">
                    <MenuItem Header="{Binding T7.FeedbackMapCaption}" Command="{Binding T7.ShowAfrFeedbackMapCommand}" />
                    <MenuItem Header="Show feedback counter map" Command="{Binding T7.ShowAfrCounterMapCommand}" />
                    <MenuItem Header="{Binding T7.ClearFeedbackCaption}" Command="{Binding T7.ClearAfrFeedbackMapCommand}" />
                    <MenuItem Header="Show AFR target map" Command="{Binding T7.ShowAfrTargetMapCommand}" />
                </MenuItem>
                <MenuItem Header="AFR maps" IsVisible="{Binding IsT5}">
                    <MenuItem Header="Show AFR target map" Command="{Binding T5.ShowAfrCommand}" CommandParameter="TargetAFR" />
                    <MenuItem Header="Show AFR feedback map" Command="{Binding T5.ShowAfrCommand}" CommandParameter="FeedbackAFR" />
                    <MenuItem Header="Show AFR error map" Command="{Binding T5.ShowAfrCommand}" CommandParameter="FeedbackvsTargetAFR" />
                    <MenuItem Header="Show idle AFR target map" Command="{Binding T5.ShowAfrCommand}" CommandParameter="IdleTargetAFR" />
                    <MenuItem Header="Show idle AFR feedback map" Command="{Binding T5.ShowAfrCommand}" CommandParameter="IdleFeedbackAFR" />
                    <MenuItem Header="Show idle AFR error map" Command="{Binding T5.ShowAfrCommand}" CommandParameter="IdleFeedbackvsTargetAFR" />
                    <MenuItem Header="Generate AFR target map" Command="{Binding T5.GenerateAfrTargetCommand}" />
                </MenuItem>
                <!-- T7Suite's barExtraOnline: SaabOpenTech's functions on the car's I-bus (Tag: the program's arguments) -->
                <MenuItem Header="Extra functions" IsVisible="{Binding IsT7}">
                    <MenuItem Header="Set ethanol content" Command="{Binding ShowEcuMapCommand}" CommandParameter="E85.X_EthAct_Tech2" />
                    <MenuItem Header="Set seatbelt ping on" Tag="S 1" Click="OnSaabOpenTech" />
                    <MenuItem Header="Set seatbelt ping off" Tag="S 0" Click="OnSaabOpenTech" />
                    <MenuItem Header="Set double unlocking with remote on" Tag="U 1" Click="OnSaabOpenTech" />
                    <MenuItem Header="Set double unlocking with remote off" Tag="U 0" Click="OnSaabOpenTech" />
                    <MenuItem Header="Get trionic info" Tag="I" Click="OnSaabOpenTech" />
                    <MenuItem Header="SID display test" Tag="T" Click="OnSaabOpenTech" />
                    <MenuItem Header="Read trionic engine data" Tag="M" Click="OnSaabOpenTech" />
                    <MenuItem Header="Get SPA info and fault codes" Tag="P" Click="OnSaabOpenTech" />
                    <MenuItem Header="Get alarm level" Tag="Z" Click="OnSaabOpenTech" />
                    <MenuItem Header="Set alarm level no alarm" Tag="Z 0" Click="OnSaabOpenTech" />
                    <MenuItem Header="Set alarm level glass break sensor" Tag="Z 1" Click="OnSaabOpenTech" />
                    <MenuItem Header="Set alarm level glass break and tilt sensor" Tag="Z 2" Click="OnSaabOpenTech" />
                </MenuItem>
                <MenuItem Header="Synchronize to binary" Click="OnSyncToBinary" IsVisible="{Binding IsT7}" />
                <MenuItem Header="Synchronize to ECU" Click="OnSyncToEcu" IsVisible="{Binding IsT7}" />
                <MenuItem Header="Upload tuning package to ECU" Click="OnUploadPackage" IsVisible="{Binding IsT7}" />
                <MenuItem Header="Generate tuning package from ECU" Click="OnGeneratePackage" IsVisible="{Binding IsT7}" />
                <MenuItem Header="Synchronize maps" Command="{Binding T5.SynchronizeMapsCommand}" IsVisible="{Binding IsT5}" />
                <MenuItem Header="Compare ECU with binary" Click="OnCompareEcu" IsVisible="{Binding IsT5}" />
                <Separator IsVisible="{Binding IsT5Advanced}" c:Ribbon.Group="Autotune" />
                <MenuItem Header="Toggle Autotune" InputGesture="Shift+F5" Command="{Binding T5Realtime.ToggleAutotuneCommand, FallbackValue={x:Null}}"
                          IsVisible="{Binding IsT5Advanced}" />
                <MenuItem Header="Autotune ignition" Click="OnIgnitionAutotune" IsVisible="{Binding IsT5Advanced}" />
                <MenuItem Header="Ignition lock map" Command="{Binding T5.ShowIgnitionLocksCommand}" IsVisible="{Binding IsT5}" />
                <MenuItem Header="Release locked ignition cells" Command="{Binding T5.ReleaseIgnitionLocksCommand}" IsVisible="{Binding IsT5}" />
            </MenuItem>
            <MenuItem x:Name="EcuMenu" Header="E_CU" c:Ribbon.Group="CAN Flasher">
                <MenuItem Header="Read ECU" Click="OnReadEcu" />
                <MenuItem Header="Flash current file to ECU" Click="OnFlashEcu" IsEnabled="{Binding HasFile}" />
                <MenuItem Header="Get SRAM snapshot" Command="{Binding T7.GetSramSnapshotCommand}" IsVisible="{Binding IsT7}" />
                <MenuItem Header="Get SRAM snapshot" Click="OnDownloadSram" IsVisible="{Binding IsT5}" />
                <MenuItem Header="Upload SRAM to ECU" Click="OnUploadSram" IsVisible="{Binding IsT5}" />
                <MenuItem Header="Recover ECU" Click="OnRecoverEcu" IsVisible="{Binding IsT8}" />
            </MenuItem>
            <MenuItem Header="_Skin" c:Ribbon.Group="Available skins">
                <MenuItem Header="Light" Click="OnSkin" Tag="Light" />
                <MenuItem Header="Dark" Click="OnSkin" Tag="Dark" />
                <MenuItem Header="Follow the system" Click="OnSkin" Tag="Default" />
                <Separator c:Ribbon.Group="Window layout" />
                <MenuItem Header="Cascade windows" Click="OnCascade" />
                <MenuItem Header="Tile windows horizontally" Click="OnTileHorizontal" />
                <MenuItem Header="Tile windows vertically" Click="OnTileVertical" />
                <MenuItem Header="Dock all floating windows" Command="{Binding DockAllCommand}" />
            </MenuItem>
            <MenuItem Header="_Help" c:Ribbon.Group="Documentation">
                <MenuItem Header="User manual" Click="OnHelpFile" Tag="T5_manual.pdf" IsVisible="{Binding IsT5}" />
                <MenuItem Header="Trionic 5 documentation" Click="OnHelpFile" Tag="Trionic 5.pdf" IsVisible="{Binding IsT5}" />
                <MenuItem Header="User manual" Click="OnHelpFile" Tag="T7_manual.pdf" IsVisible="{Binding IsT7}" />
                <MenuItem Header="Trionic 7 documentation" Click="OnHelpFile" Tag="Trionic 7.pdf" IsVisible="{Binding IsT7}" />
                <MenuItem Header="User manual" Click="OnHelpFile" Tag="T8_manual.pdf" IsVisible="{Binding IsT8}" />
                <MenuItem Header="Trionic 8 documentation" Click="OnHelpFile" Tag="Trionic 8.pdf" IsVisible="{Binding IsT8}" />
                <MenuItem Header="Release notes" Click="OnReleaseNotes" />
                <Separator c:Ribbon.Group="Help on TxSuite" />
                <MenuItem Header="Check for updates" Click="OnCheckForUpdates" />
                <MenuItem x:Name="AboutMenu" Header="About TxSuite" Click="OnAbout" />
            </MenuItem>
        </Menu>
        <c:Ribbon DockPanel.Dock="Top" Menu="{Binding #MainMenu}" IsVisible="{Binding ShowRibbon}" />
        <sv:StatusBar DockPanel.Dock="Bottom" />
        <sv:SuiteWorkspace />
    </DockPanel>
</sv:SuiteMainView>
