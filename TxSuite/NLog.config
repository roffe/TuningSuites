<?xml version="1.0" encoding="utf-8" ?>
<!-- TxSuite's: T7Suite's NLog.config with the T5 and T8 cores' loggers, in <AppData>/MattiasC/TxSuite. Settings → Logging turns each
     file target on or off and sets the level of the rules writing to it (Logging.cs, when TxSuite starts and on the settings' Ok), so the
     levels below only say which levels a rule has before that -->
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

  <variable name="layout" value="${longdate} ${message} ${exception:format=tostring}"/>
  <targets>
    <target name="canlogfile" xsi:type="File" fileName="${specialfolder:folder=ApplicationData}/MattiasC/TxSuite/canLog${shortdate}.txt" keepFileOpen="true" layout="${layout}" />
    <target name="devicelogfile" xsi:type="File" fileName="${specialfolder:folder=ApplicationData}/MattiasC/TxSuite/deviceLog${shortdate}.txt" keepFileOpen="true" layout="${layout}" />
    <target name="kwplogfile" xsi:type="File" fileName="${specialfolder:folder=ApplicationData}/MattiasC/TxSuite/kwpLog${shortdate}.txt" keepFileOpen="true" layout="${layout}" />
    <target name="flasherlogfile" xsi:type="File" fileName="${specialfolder:folder=ApplicationData}/MattiasC/TxSuite/flasherLog${shortdate}.txt" keepFileOpen="true" layout="${layout}" />
    <target name="apilogfile" xsi:type="File" fileName="${specialfolder:folder=ApplicationData}/MattiasC/TxSuite/apiLog${shortdate}.txt" keepFileOpen="true" layout="${layout}" />
    <target name="uilogfile" xsi:type="File" fileName="${specialfolder:folder=ApplicationData}/MattiasC/TxSuite/uiLog${shortdate}.txt" keepFileOpen="true" layout="${layout}" />
    <target name="debugger" xsi:type="Debugger" layout="${logger}::${message}"/>
  </targets>

  <rules>
    <logger name="TrionicCANLib.CAN.*" level="Trace" writeTo="canlogfile" />
    <logger name="TrionicCANLib.CAN.*" level="Debug" writeTo="devicelogfile" />
    <!-- the adapter drivers keep their original namespaces (as in the flasher's config) -->
    <logger name="Lawicel.*" level="Trace" writeTo="canlogfile" />
    <logger name="Lawicel.*" minLevel="Debug" writeTo="devicelogfile" />
    <logger name="Combi.*" level="Trace" writeTo="canlogfile" />
    <logger name="Combi.*" minLevel="Debug" writeTo="devicelogfile" />
    <logger name="TrionicCANLib.KWP.*" level="Trace" writeTo="kwplogfile" />
    <logger name="TrionicCANLib.Flasher.*" level="Debug" writeTo="flasherlogfile" />
    <logger name="TrionicCANLib.API.*" level="Debug" writeTo="apilogfile" />
    <logger name="T7.*" minLevel="Trace" writeTo="uilogfile" />
    <logger name="T7App.*" minLevel="Trace" writeTo="uilogfile" />
    <!-- the T5 and T8 cores keep their old suites' namespaces -->
    <logger name="Trionic5Tools.*" minLevel="Trace" writeTo="uilogfile" />
    <logger name="T5App.*" minLevel="Trace" writeTo="uilogfile" />
    <logger name="T8SuitePro.*" minLevel="Trace" writeTo="uilogfile" />
    <logger name="T8App.*" minLevel="Trace" writeTo="uilogfile" />
    <logger name="TxSuite.*" minLevel="Trace" writeTo="uilogfile" />
    <!-- the shared code: settings, the ECU thread, logs and packages (SuiteCore), the main window (SuiteApp) -->
    <logger name="CommonSuite.*" minLevel="Trace" writeTo="uilogfile" />
    <logger name="SuiteApp.*" minLevel="Trace" writeTo="uilogfile" />

    <logger name="TrionicCANLib.CAN.*" level="Debug" writeTo="debugger" />
    <logger name="TrionicCANLib.Flasher.*" level="Debug" writeTo="debugger" />
    <logger name="TrionicCANLib.API.*" level="Debug" writeTo="debugger" />
    <logger name="T7.*" minLevel="Trace" writeTo="debugger" />
  </rules>
</nlog>
