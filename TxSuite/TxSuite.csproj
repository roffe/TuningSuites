<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>TxSuite</RootNamespace>
    <AssemblyName>TxSuite</AssemblyName>
    <!-- the version comes from the nearest Txsuite_vX.Y.Z tag (Directory.Build.props), the old suites' tag scheme -->
    <VersionTagPrefix>Txsuite_</VersionTagPrefix>
    <ApplicationIcon>TxSuite.ico</ApplicationIcon>
    <Company>MattiasC</Company>
    <Copyright>Copyright © Dilemma, Mattias Claesson</Copyright>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <!-- ponytail: Windows stays 32-bit as the flasher, most J2534 and the Lawicel CANUSB drivers only ship x86 DLLs. Only the launcher
       (TxSuite.exe) is x86, the dll stays AnyCPU: the app tests' 64-bit test host loads it (x86 failed every app test) -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == '' and '$(OS)' == 'Windows_NT'">
    <DefaultAppHostRuntimeIdentifier>win-x86</DefaultAppHostRuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="TxSuite.ico" />
    <None Update="NLog.config" CopyToOutputDirectory="PreserveNewest" />
    <!-- Help → User manual / Trionic N documentation of the open file's ECU -->
    <None Include="..\T5_manual.pdf" Link="T5_manual.pdf" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Trionic 5.pdf" Link="Trionic 5.pdf" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\T7_manual.pdf" Link="T7_manual.pdf" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Trionic 7.pdf" Link="Trionic 7.pdf" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\T8_manual.pdf" Link="T8_manual.pdf" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Trionic 8.pdf" Link="Trionic 8.pdf" CopyToOutputDirectory="PreserveNewest" />
    <!-- T8's Tuning Wizard packs (T8Suite's installer put them into TuningPacks next to the program) -->
    <None Include="..\TuningPacks\*.t8x" Link="TuningPacks\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- Kvaser's CANlib for TrionicCANLib on Windows, as the flasher ships it -->
    <None Include="$(TrionicDir)\Libs\canlib32.dll" Link="canlib32.dll" CopyToOutputDirectory="PreserveNewest"
          Condition="$(RuntimeIdentifier.StartsWith('win')) or ('$(RuntimeIdentifier)' == '' and '$(OS)' == 'Windows_NT')" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- each ECU's module and windows -->
    <ProjectReference Include="..\T5App\T5App.csproj" />
    <ProjectReference Include="..\T7App\T7App.csproj" />
    <ProjectReference Include="..\T8App\T8App.csproj" />
  </ItemGroup>

</Project>
