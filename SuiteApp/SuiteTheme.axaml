<!-- The suites' look: Fluent with T7Suite's DevExpress light skin and the workspace styles. Each app includes it in App.axaml. -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="using:MapControls"
        xmlns:c="using:SuiteApp.Controls">
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <!-- T7Suite's DevExpress light skin: white chrome with #ABABAB borders, grey MDI workspace, blue window titles, light grey
                     buttons and light blue selection. Light only, Dark keeps the themes' own look; the Suite keys are
                     ours (styles below), the others Fluent's, the DataGrid's and Dock's -->
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="SuiteMdiWorkspaceBrush" Color="#808080" />
                    <SolidColorBrush x:Key="SuiteMdiTitleBrush" Color="#0072C6" />
                    <SolidColorBrush x:Key="SuiteMdiTitleInactiveBrush" Color="#6A87AD" />
                    <SolidColorBrush x:Key="SuiteMapHeaderBackground" Color="White" />
                    <SolidColorBrush x:Key="SuiteMapHeaderForeground" Color="#1E1C76" />
                    <SolidColorBrush x:Key="SuiteMapHeaderLines" Color="#B0C4DE" />
                    <SolidColorBrush x:Key="SuiteMapGridLines" Color="#D0D0D0" />

                    <SolidColorBrush x:Key="DockSurfaceHeaderBrush" Color="White" />
                    <SolidColorBrush x:Key="DockSurfaceHeaderActiveBrush" Color="White" />
                    <SolidColorBrush x:Key="DockBorderSubtleBrush" Color="#ABABAB" />
                    <SolidColorBrush x:Key="DockSeparatorBrush" Color="#D5D5D5" />
                    <SolidColorBrush x:Key="DockSplitterIdleBrush" Color="#D5D5D5" />
                    <SolidColorBrush x:Key="DockTabActiveForegroundBrush" Color="#3B3B3B" />
                    <SolidColorBrush x:Key="DockChromeButtonForegroundBrush" Color="#6D6D6D" />
                    <SolidColorBrush x:Key="DockChromeButtonHoverBackgroundBrush" Color="#DCE6F4" />
                    <SolidColorBrush x:Key="DockChromeButtonPressedBackgroundBrush" Color="#C5D9F1" />
                    <SolidColorBrush x:Key="DockTabActiveBackgroundBrush" Color="White" />
                    <SolidColorBrush x:Key="DockTabHoverBackgroundBrush" Color="#DCE6F4" />
                    <SolidColorBrush x:Key="DockDocumentTabPointerOverForegroundBrush" Color="#0072C6" />
                    <SolidColorBrush x:Key="DockDocumentTabCloseSelectedForegroundBrush" Color="#3B3B3B" />
                    <SolidColorBrush x:Key="DockDocumentTabClosePointerOverForegroundBrush" Color="#3B3B3B" />

                    <LinearGradientBrush x:Key="ButtonBackground" StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Offset="0" Color="#F0F0F0" />
                        <GradientStop Offset="1" Color="#E5E5E5" />
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#DCE6F4" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#C5D9F1" />
                    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#F4F4F4" />
                    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#ABABAB" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#7A9CD3" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#5B87C7" />
                    <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#D5D5D5" />
                    <LinearGradientBrush x:Key="ToggleButtonBackground" StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Offset="0" Color="#F0F0F0" />
                        <GradientStop Offset="1" Color="#E5E5E5" />
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="#DCE6F4" />
                    <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="#C5D9F1" />
                    <SolidColorBrush x:Key="ToggleButtonBackgroundDisabled" Color="#F4F4F4" />
                    <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#C5D9F1" />
                    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#BCDCF4" />
                    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#A9C8EC" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="#ABABAB" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushPointerOver" Color="#7A9CD3" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushPressed" Color="#5B87C7" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushDisabled" Color="#D5D5D5" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="#5B87C7" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="#5B87C7" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed" Color="#5B87C7" />
                    <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="Black" />
                    <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="Black" />
                    <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="Black" />
                    <SolidColorBrush x:Key="RepeatButtonBackgroundDisabled" Color="#F4F4F4" />
                    <SolidColorBrush x:Key="ComboBoxBackground" Color="White" />
                    <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="White" />
                    <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#ABABAB" />
                    <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#7A9CD3" />
                    <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="#5B87C7" />
                    <SolidColorBrush x:Key="TextControlBackground" Color="White" />
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="White" />
                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="#ABABAB" />
                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#7A9CD3" />
                    <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="White" />
                    <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#ABABAB" />
                    <CornerRadius x:Key="ControlCornerRadius">2</CornerRadius>

                    <SolidColorBrush x:Key="DataGridGridLinesBrush" Color="#D5D5D5" />
                    <SolidColorBrush x:Key="DataGridColumnHeaderForegroundBrush" Color="Black" />
                    <SolidColorBrush x:Key="DataGridRowGroupHeaderBackgroundBrush" Color="#E1E1E1" />
                    <SolidColorBrush x:Key="DataGridRowHoveredBackgroundColor" Color="#EEF5FC" />
                    <SolidColorBrush x:Key="DataGridRowSelectedBackgroundBrush" Color="#CDE6F7" />
                    <SolidColorBrush x:Key="DataGridRowSelectedHoveredBackgroundBrush" Color="#BCDCF4" />
                    <!-- T7Suite kept the focused row's look when the grid lost focus (EnableAppearanceHideSelection = false) -->
                    <SolidColorBrush x:Key="DataGridRowSelectedUnfocusedBackgroundBrush" Color="#CDE6F7" />
                    <SolidColorBrush x:Key="DataGridRowSelectedHoveredUnfocusedBackgroundBrush" Color="#BCDCF4" />
                    <!-- gridViewSymbols' FocusedRow.ForeColor, also on a coloured symbol name -->
                    <SolidColorBrush x:Key="SuiteSymbolSelectedForeground" Color="MediumBlue" />
                    <SolidColorBrush x:Key="SuiteSymbolSelectedNameForeground" Color="MediumBlue" />
                    <x:Double x:Key="DataGridRowSelectedBackgroundOpacity">1</x:Double>
                    <x:Double x:Key="DataGridRowSelectedHoveredBackgroundOpacity">1</x:Double>
                    <x:Double x:Key="DataGridRowSelectedUnfocusedBackgroundOpacity">1</x:Double>
                    <x:Double x:Key="DataGridRowSelectedHoveredUnfocusedBackgroundOpacity">1</x:Double>
                </ResourceDictionary>
                <!-- the window's own text colour; an unset key would leave the titles without a brush -->
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="SuiteMdiTitleBrush" Color="{DynamicResource SystemBaseHighColor}" />
                    <SolidColorBrush x:Key="SuiteSymbolSelectedForeground" Color="{DynamicResource SystemBaseHighColor}" />
                    <SolidColorBrush x:Key="SuiteSymbolSelectedNameForeground" Color="Black" />
                    <SolidColorBrush x:Key="SuiteMdiTitleInactiveBrush" Color="{DynamicResource SystemBaseHighColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <!-- every host builds its own document view (Dock's recycling moved views between the tabbed and the inner window layout) -->
            <c:NoRecycling x:Key="DocumentRecycling" />
        </ResourceDictionary>
    </Styles.Resources>
    <FluentTheme>
        <FluentTheme.Palettes>
            <!-- same neutral dark palette as TrionicCANFlasher, Fluent's own is built on pure black -->
            <ColorPaletteResources x:Key="Dark"
                                   RegionColor="#FF202020"
                                   AltHigh="#FF1B1B1B" AltMediumHigh="#CC1B1B1B" AltMedium="#991B1B1B"
                                   AltMediumLow="#661B1B1B" AltLow="#331B1B1B"
                                   ChromeLow="#FF1E1E1E" ChromeMedium="#FF282828" ChromeMediumLow="#FF323232"
                                   ChromeBlackHigh="#FF141414" ChromeBlackMedium="#CC141414"
                                   ChromeBlackMediumLow="#99141414" ChromeBlackLow="#33141414"
                                   BaseLow="#1CFFFFFF" BaseMediumLow="#40FFFFFF" />
        </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
    <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />
    <DockFluentTheme />
    <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
    <StyleInclude Source="avares://AvaloniaHex/Themes/Fluent/AvaloniaHex.axaml" />
    <!-- inner windows measured at their own size, not the workspace's (a class selector outranks the template's panel) -->
    <Style Selector="ItemsControl.MdiLayoutItems">
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <c:ArrangedMdiLayoutPanel LayoutManager="{Binding $parent[MdiDocumentControl].LayoutManager}" />
            </ItemsPanelTemplate>
        </Setter>
    </Style>
    <!-- the whole MDI title bar moves the window; its title part was Dock's drag-to-dock handle (tabs, splits) -->
    <Style Selector="MdiDocumentWindow /template/ Border#PART_DragHandle">
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <!-- the light skin's MDI workspace, window titles and map headers (resources above, unset in Dark) -->
    <Style Selector="MdiDocumentControl /template/ Border#PART_Root > Grid">
        <Setter Property="Background" Value="{DynamicResource SuiteMdiWorkspaceBrush}" />
    </Style>
    <Style Selector="MdiDocumentWindow /template/ Border#PART_Header">
        <Setter Property="TextElement.Foreground" Value="{DynamicResource SuiteMdiTitleBrush}" />
    </Style>
    <Style Selector="MdiDocumentWindow:not(:active) /template/ Border#PART_Header">
        <Setter Property="TextElement.Foreground" Value="{DynamicResource SuiteMdiTitleInactiveBrush}" />
    </Style>
    <Style Selector="mc|MapGrid">
        <Setter Property="HeaderBackground" Value="{DynamicResource SuiteMapHeaderBackground}" />
        <Setter Property="HeaderForeground" Value="{DynamicResource SuiteMapHeaderForeground}" />
        <Setter Property="HeaderLines" Value="{DynamicResource SuiteMapHeaderLines}" />
        <Setter Property="GridLines" Value="{DynamicResource SuiteMapGridLines}" />
    </Style>
    <Style Selector="DockControl">
        <Setter Property="(ControlRecyclingDataTemplate.ControlRecycling)" Value="{StaticResource DocumentRecycling}" />
    </Style>
    <!-- Fluent's tab headers are sized for touch, the suite is a dense desktop tool -->
    <Style Selector="TabStripItem, TabItem">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="10,2" />
    </Style>
</Styles>
