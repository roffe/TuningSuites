<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SuiteApp.ViewModels"
        xmlns:cs="using:CommonSuite"
        x:Class="SuiteApp.Views.TransactionLogWindow"
        x:DataType="vm:TransactionLogViewModel"
        Title="Transaction log" Width="900" Height="500" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
            <Button Content="Roll back" IsEnabled="{Binding CanRollBack}" Click="OnRollBack" />
            <Button Content="Roll forward" IsEnabled="{Binding CanRollForward}" Click="OnRollForward" />
            <Button Content="Ok" MinWidth="80" IsCancel="True" Click="OnOk" />
        </StackPanel>
        <TextBlock DockPanel.Dock="Top" Text="Logged transactions" FontWeight="SemiBold" Margin="0,0,0,6" />
        <DataGrid x:Name="Grid" ItemsSource="{Binding Entries}" SelectedItem="{Binding Selected}" GridLinesVisibility="Horizontal"
                  SelectionMode="Single" CellEditEnded="OnCellEditEnded">
            <DataGrid.Columns>
                <DataGridTextColumn x:DataType="cs:TransactionEntry" Header="Timestamp" IsReadOnly="True"
                                    Binding="{Binding EntryDateTime, Mode=OneWay, StringFormat='dd/MM/yyyy HH:mm:ss'}" />
                <DataGridTextColumn x:DataType="cs:TransactionEntry" Header="Symbol" IsReadOnly="True" Binding="{Binding SymbolName}" />
                <DataGridTextColumn x:DataType="cs:TransactionEntry" Header="Note" Binding="{Binding Note}" Width="*" />
                <DataGridTextColumn x:DataType="cs:TransactionEntry" Header="Address" IsReadOnly="True" Binding="{Binding SymbolAddress}" />
                <DataGridTextColumn x:DataType="cs:TransactionEntry" Header="Length" IsReadOnly="True" Binding="{Binding SymbolLength}" />
                <DataGridCheckBoxColumn x:DataType="cs:TransactionEntry" Header="Rolled back" IsReadOnly="True" Binding="{Binding IsRolledBack}" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
