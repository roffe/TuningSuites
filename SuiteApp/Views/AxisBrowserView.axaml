<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SuiteApp.ViewModels"
             xmlns:cs="using:CommonSuite"
             x:Class="SuiteApp.Views.AxisBrowserView"
             x:DataType="vm:AxisBrowserViewModel">
    <DataGrid x:Name="Grid" ItemsSource="{Binding Rows}" IsReadOnly="True" GridLinesVisibility="Horizontal" DoubleTapped="OnDoubleTapped">
        <DataGrid.Columns>
            <DataGridTextColumn x:DataType="cs:AxisInfo" Header="Symbol" Binding="{Binding Symbol, Mode=OneWay}" Width="2*" />
            <DataGridTextColumn x:DataType="cs:AxisInfo" Header="Description" Binding="{Binding Description, Mode=OneWay}" Width="3*" />
            <DataGridTextColumn x:DataType="cs:AxisInfo" Header="X axis" Binding="{Binding XAxis, Mode=OneWay}" Width="2*" />
            <DataGridTextColumn x:DataType="cs:AxisInfo" Header="X axis description" Binding="{Binding XDescription, Mode=OneWay}" Width="*" />
            <DataGridTextColumn x:DataType="cs:AxisInfo" Header="Y axis" Binding="{Binding YAxis, Mode=OneWay}" Width="2*" />
            <DataGridTextColumn x:DataType="cs:AxisInfo" Header="Y axis description" Binding="{Binding YDescription, Mode=OneWay}" Width="*" />
        </DataGrid.Columns>
    </DataGrid>
</UserControl>
