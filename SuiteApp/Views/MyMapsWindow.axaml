<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SuiteApp.ViewModels"
        x:Class="SuiteApp.Views.MyMapsWindow"
        x:DataType="vm:MyMapsViewModel"
        Title="Define myMaps" Width="760" Height="480" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
            <Button Content="Add" Click="OnAdd" />
            <Button Content="Remove" Click="OnRemove" />
            <Panel Width="300" />
            <Button Content="Ok" MinWidth="80" IsDefault="True" Click="OnOk" />
            <Button Content="Cancel" MinWidth="80" IsCancel="True" Click="OnCancel" />
        </StackPanel>
        <DataGrid x:Name="Grid" ItemsSource="{Binding Rows}" GridLinesVisibility="Horizontal" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn x:DataType="vm:MyMapRow" Header="Category" Binding="{Binding Category}" Width="*" />
                <DataGridTextColumn x:DataType="vm:MyMapRow" Header="Title" Binding="{Binding Title}" Width="*" />
                <DataGridTextColumn x:DataType="vm:MyMapRow" Header="Symbol" Binding="{Binding Symbol}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
