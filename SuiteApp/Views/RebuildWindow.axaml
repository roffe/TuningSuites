<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SuiteApp.ViewModels"
        x:Class="SuiteApp.Views.RebuildWindow"
        x:DataType="vm:RebuildViewModel"
        Title="Rebuild a project file" SizeToContent="WidthAndHeight" CanResize="False" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="16" Spacing="12">
        <HeaderedContentControl Header="Choose restore options">
            <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="Rebuild upto" VerticalAlignment="Center" />
                    <CalendarDatePicker SelectedDate="{Binding UpTo}" />
                </StackPanel>
                <CheckBox Content="Store result as current project file" IsChecked="{Binding StoreAsCurrent}" />
            </StackPanel>
        </HeaderedContentControl>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="Ok" MinWidth="80" IsDefault="True" Click="OnOk" />
            <Button Content="Cancel" MinWidth="80" IsCancel="True" Click="OnCancel" />
        </StackPanel>
    </StackPanel>
</Window>
