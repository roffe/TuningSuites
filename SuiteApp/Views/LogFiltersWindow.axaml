<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SuiteApp.ViewModels"
        x:Class="SuiteApp.Views.LogFiltersWindow"
        x:DataType="vm:LogFiltersViewModel"
        Title="Log filters setup..." Width="760" Height="420" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
            <Button Content="Add" Click="OnAdd" />
            <Button Content="Remove" Click="OnRemove" />
            <Panel Width="320" />
            <Button Content="Ok" MinWidth="80" IsDefault="True" Click="OnOk" />
            <Button Content="Cancel" MinWidth="80" IsCancel="True" Click="OnCancel" />
        </StackPanel>
        <DataGrid x:Name="Grid" ItemsSource="{Binding Rows}" GridLinesVisibility="Horizontal" SelectionMode="Single" CanUserSortColumns="False">
            <DataGrid.Columns>
                <DataGridTemplateColumn x:DataType="vm:LogFilterRow" Header="Symbol" Width="*">
                    <DataTemplate x:DataType="vm:LogFilterRow">
                        <AutoCompleteBox Text="{Binding Symbol}" FilterMode="ContainsOrdinal" PlaceholderText="Symbol"
                                         ItemsSource="{Binding $parent[Window].((vm:LogFiltersViewModel)DataContext).SymbolNames}" />
                    </DataTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn x:DataType="vm:LogFilterRow" Header="Type" Width="150">
                    <DataTemplate x:DataType="vm:LogFilterRow">
                        <ComboBox ItemsSource="{x:Static vm:LogFiltersViewModel.Types}" SelectedIndex="{Binding Type}" HorizontalAlignment="Stretch" />
                    </DataTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn x:DataType="vm:LogFilterRow" Header="Value" Binding="{Binding Value}" Width="110" />
                <DataGridCheckBoxColumn x:DataType="vm:LogFilterRow" Header="Active" Binding="{Binding Active}" Width="80" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
