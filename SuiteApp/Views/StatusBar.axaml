<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SuiteApp.ViewModels"
             x:Class="SuiteApp.Views.StatusBar"
             x:DataType="vm:MainWindowViewModel">
    <!-- ribbonStatusBar1: open/normal binary, file name, checksum (T8Suite), SRAM file, CAN status, update check; progress and
         read-only state on the right. The accent bar with white text and dividers is the ribbon skin's; empty items are hidden as
         the suites showed nothing for them -->
    <Border Padding="4,2" Background="{DynamicResource SystemAccentColorDark1}" TextElement.Foreground="White">
        <Border.Styles>
            <Style Selector="TextBlock.status">
                <Setter Property="Padding" Value="8,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="IsVisible" Value="{Binding $self.Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </Style>
        </Border.Styles>
        <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <TextBlock Classes="status" Text="{Binding ProgressText}" />
                <Border Width="1" Margin="0,2" Background="#80FFFFFF" IsVisible="{Binding ProgressText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <TextBlock Classes="status" Text="{Binding ReadOnlyText}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Classes="status" Text="{Binding OpenClosedText}" />
                <Border Width="1" Margin="0,2" Background="#80FFFFFF" IsVisible="{Binding OpenClosedText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <TextBlock Classes="status" Text="{Binding FileNameText}" />
                <Border Width="1" Margin="0,2" Background="#80FFFFFF" IsVisible="{Binding ChecksumText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <TextBlock Classes="status" Text="{Binding ChecksumText}" />
                <Border Width="1" Margin="0,2" Background="#80FFFFFF" IsVisible="{Binding SramFileText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <TextBlock Classes="status" Text="{Binding SramFileText}" />
                <Border Width="1" Margin="0,2" Background="#80FFFFFF" IsVisible="{Binding CanStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <TextBlock Classes="status" Text="{Binding CanStatus}" />
                <Border Width="1" Margin="0,2" Background="#80FFFFFF" IsVisible="{Binding UpdateText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <TextBlock Classes="status" Text="{Binding UpdateText}" />
            </StackPanel>
        </DockPanel>
    </Border>
</UserControl>
