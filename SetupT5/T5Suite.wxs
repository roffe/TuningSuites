<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

	<!-- the old T5Suite 2.0 setup's (SetupT5SuiteII.vdproj) upgrade code and folder: installing this replaces the old T5SuiteII -->
	<?define UpgradeCode="{85094B92-5F73-4D18-A5DD-994336DF4031}"?>
	<?define Manufacturer="MattiasC"?>

	<!-- Version is the exe's FileVersion, from the T5suite_v git tag (Directory.Build.props); MSI uses its first three fields.
	     The old T5SuiteII was 2.0.30, so only a tag above that (T5suite_v2.1.0) replaces it -->
	<Package Name="T5Suite" Language="1033" Version="!(bind.FileVersion.T5SuiteExe)" Codepage="1252" Manufacturer="$(var.Manufacturer)" UpgradeCode="$(var.UpgradeCode)" InstallerVersion="300" ProductCode="*">
		<SummaryInformation Manufacturer="$(var.Manufacturer)" />
		<MediaTemplate EmbedCab="yes" />


		<Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
		<ui:WixUI Id="WixUI_InstallDir" />
		<WixVariable Id="WixUILicenseRtf" Value="disclaimer.rtf" />


		<!-- Lawicel canusbdrv.dll needs the VC++ 2010 runtime -->
		<Feature Id="VCRedist" Title="Visual C++ 10.0 Runtime" AllowAdvertise="no" Display="hidden" Level="1">
			<MergeRef Id="VCRedist" />
		</Feature>

		<DirectoryRef Id="INSTALLFOLDER">
			<Component Id="T5SuiteExeComponent">
				<File Id="T5SuiteExe" Name="T5Suite.exe" KeyPath="yes" DiskId="1" Source="$(var.PublishDir)\T5Suite.exe" />
				<Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="T5Suite" Icon="T5Suite.ico" IconIndex="0" Show="normal" WorkingDirectory="TARGETDIR" Advertise="yes" />
				<Shortcut Id="DesktopShortcut" Directory="DesktopFolder" Name="T5Suite" Icon="T5Suite.ico" IconIndex="0" Show="normal" WorkingDirectory="TARGETDIR" Advertise="yes" />
			</Component>
			<!-- .bin files list T5Suite under Open with; their default program stays as it is (T5Suite's setup registered none) -->
			<Component Id="BinOpenWith">
				<RegistryValue Root="HKLM" Key="Software\Classes\.bin\OpenWithProgids" Name="T5Suite.bin" Type="string" Value="T5Suite" KeyPath="yes" />
				<RegistryValue Root="HKLM" Key="Software\Classes\T5Suite.bin" Type="string" Value="Trionic 5 binary" />
				<RegistryValue Root="HKLM" Key="Software\Classes\T5Suite.bin\DefaultIcon" Type="string" Value="[INSTALLFOLDER]T5Suite.exe,0" />
				<RegistryValue Root="HKLM" Key="Software\Classes\T5Suite.bin\shell\open\command" Type="string" Value="&quot;[INSTALLFOLDER]T5Suite.exe&quot; &quot;%1&quot;" />
			</Component>
			<Merge Id="VCRedist" SourceFile="$(var.TrionicDir)\SetupCANFlasher\Microsoft_VC100_CRT_x86.msm" DiskId="1" Language="0"/>
		</DirectoryRef>


		<Feature Id="DefaultFeature" ConfigurableDirectory="INSTALLFOLDER" Level="1">
			<ComponentRef Id="T5SuiteExeComponent" Primary="yes" />
			<ComponentRef Id="BinOpenWith" />
			<!-- the rest of the self-contained publish folder (runtime, Avalonia, manuals, Binaries, NLog.config, libusb-1.0.dll) -->
			<Files Directory="INSTALLFOLDER" Include="$(var.PublishDir)\**">
				<Exclude Files="$(var.PublishDir)\T5Suite.exe" />
				<!-- native SkiaSharp/HarfBuzz symbols, ~100 MB -->
				<Exclude Files="$(var.PublishDir)\lib*.pdb" />
			</Files>
		</Feature>

		<Icon Id="T5Suite.ico" SourceFile="$(sys.SOURCEFILEDIR)..\T5App\T5Suite.ico" />
		<Property Id="ARPPRODUCTICON" Value="T5Suite.ico" />
		<MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A later version of [ProductName] is already installed. Setup will now exit." />

		<!-- the old setup's folder: Program Files (x86)\MattiasC\T5SuiteII -->
		<StandardDirectory Id="ProgramFilesFolder">
			<Directory Id="ManufacturerFolder" Name="!(bind.property.Manufacturer)">
				<Directory Id="INSTALLFOLDER" Name="T5SuiteII" />
			</Directory>
		</StandardDirectory>
		<StandardDirectory Id="DesktopFolder" />
		<StandardDirectory Id="ProgramMenuFolder" />
	</Package>
</Wix>
